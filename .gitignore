# Only track specific file types
# Ignore everything by default
*

!*.yaml
!**/.??*.yaml
!*.yml
!**/.??*.yml

# Track lovelace dashboard configuration files
# Never commit Home Assistant runtime storage
.storage/

# Allow directory traversal
!*/

# Re-ignore macOS metadata files (even if they match allowed extensions)
._*

# Never commit real secrets
secrets.yaml

# Keep private Google Calendar mappings local
google_calendars.yaml

# Ignore Zigbee2MQTT configuration backups
zigbee2mqtt/configuration_backup_*.yaml

# Keep Zigbee2MQTT credentials, keys, and device topology local
zigbee2mqtt/configuration.yaml
zigbee2mqtt/devices.yaml

# Ignore CrowdSec runtime data
.storage/crowdsec/
