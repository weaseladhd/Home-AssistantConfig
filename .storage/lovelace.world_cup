                      "custom_fields": {
                        "content": "[[[\n  const st=states['sensor.world_cup_standings'];\n  const groups=(st&&st.attributes&&st.attributes.children)||[];\n  const TARGET=\"Group I\";\n  const esc=s=>(s==null?'':String(s));\n  const flag=u=>u?`<img src=\"${u}\" style=\"height:20px;vertical-align:middle;border-radius:3px;\">`:'';\n  const g=groups.find(x=>x.name===TARGET);\n  let rh='<div style=\"color:#888;font-size:12px;\">No data yet</div>';\n  if(g){ const rows=((g.standings&&g.standings.entries)||[]).map(en=>{let rank=99,pts='0';for(const s of en.stats){if(s.name==='rank')rank=parseInt(s.value);if(s.name==='points')pts=s.displayValue;}return{rank,abbr:en.team.abbreviation,flag:(en.team.logos&&en.team.logos[0]?en.team.logos[0].href:''),pts};}).sort((a,b)=>a.rank-b.rank);\n    rh=rows.map(r=>{const adv=r.rank<=2;return `<div style=\"display:flex;align-items:center;gap:8px;padding:4px 6px;border-left:3px solid ${adv?'#22c55e':'transparent'};background:${adv?'rgba(34,197,94,.12)':'transparent'};border-radius:4px;\"><span style=\"width:12px;color:${adv?'#22c55e':'#888'};font-weight:700;font-size:12px;\">${r.rank}</span>${flag(r.flag)}<span style=\"flex:1;color:#fff;font-size:13px;font-weight:${adv?'700':'500'};\">${esc(r.abbr)}</span><span style=\"color:#cbd5e1;font-weight:700;font-size:13px;\">${esc(r.pts)}</span></div>`;}).join(''); }\n  return `<div style=\"text-align:left;\"><div style=\"font-weight:800;color:#fff;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,.13);padding-bottom:4px;display:flex;justify-content:space-between;align-items:center;\">${TARGET}<span style=\"font-size:10px;opacity:.5;font-weight:500;\">tap ⓘ</span></div>${rh}</div>`;\n]]]"
