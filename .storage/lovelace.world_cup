                                "content": "[[[\n  const st=states['sensor.world_cup_standings'];\n  const sch=states['sensor.world_cup_schedule'];\n  const sb=states['sensor.world_cup_scoreboard'];\n  const TARGET=\"Group F\";\n  const esc=s=>(s==null?'':String(s));\n  const fmt=iso=>{try{return new Date(iso).toLocaleString([],{weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});}catch(e){return esc(iso);}};\n  const groups=(st&&st.attributes&&st.attributes.children)||[];\n  const g=groups.find(x=>x.name===TARGET);\n  const teams=g?((g.standings&&g.standings.entries)||[]).map(e=>e.team.abbreviation):[];\n  let matches=(sch&&sch.attributes&&sch.attributes.matches)||[];\n  if(!matches.length&&sb){matches=((sb.attributes&&sb.attributes.events)||[]).map(e=>{const c=e.competitions[0],cs=c.competitors;const h=cs.find(x=>x.homeAway==='home'),a=cs.find(x=>x.homeAway==='away');const v=c.venue||{},ad=v.address||{};return{d:e.date,a:a.team.abbreviation,h:h.team.abbreviation,as:a.score,hs:h.score,s:e.status.type.state,det:e.status.type.shortDetail,v:[v.fullName,ad.city,ad.country].filter(Boolean).join(', ')};});}\n  const gm=matches.filter(m=>teams.includes(m.a)||teams.includes(m.h)).sort((x,y)=>(x.d<y.d?-1:(x.d>y.d?1:0)));\n  const body=gm.length?gm.map(m=>{const sl=m.s==='post'?'✅ Concluded (Final)':(m.s==='in'?'🔴 In progress · '+esc(m.det):'🕐 Scheduled');const score=(m.s!=='pre'&&m.as!=null&&m.hs!=null)?` <span style=\"opacity:.85;font-weight:700;\">${esc(m.as)}–${esc(m.hs)}</span>`:'';\n    return `<div style=\"padding:11px 4px;border-bottom:1px solid rgba(255,255,255,.08);\"><div style=\"color:#fff;font-weight:700;font-size:15px;\">${esc(m.a)} v ${esc(m.h)}${score}</div><div style=\"color:#cbd5e1;font-size:13px;margin-top:3px;\">🗓 ${fmt(m.d)}</div><div style=\"color:#cbd5e1;font-size:13px;\">📍 ${esc(m.v)}</div><div style=\"font-size:13px;margin-top:3px;\">${sl}</div></div>`;}).join(''):'<div style=\"color:#888;padding:8px;\">No fixtures found.</div>';\n  return `<div style=\"text-align:left;padding:4px;\">${body}</div>`;\n]]]"
