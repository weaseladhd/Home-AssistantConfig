                                "card": [
                                  {
                                    "background": "transparent"
                                  },
                                  {
                                    "box-shadow": "none"
                                  },
                                  {
                                    "border": "none"
                                  },
                                  {
                                    "padding": "0"
                                  }
                                ],
                                "grid": [
                                  {
                                    "grid-template-areas": "\"content\""
                                  },
                                  {
                                    "grid-template-columns": "1fr"
                                  }
                                ],
                                "custom_fields": {
                                  "content": [
                                    {
                                      "justify-self": "stretch"
                                    },
                                    {
                                      "width": "100%"
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        }
                      },
                      "custom_fields": {
                        "content": "[[[\n  const st=states['sensor.world_cup_standings'];\n  const groups=(st&&st.attributes&&st.attributes.children)||[];\n  const TARGET=\"Group L\";\n  const esc=s=>(s==null?'':String(s));\n  const flag=u=>u?`<img src=\"${u}\" style=\"height:20px;vertical-align:middle;border-radius:3px;\">`:'';\n  const g=groups.find(x=>x.name===TARGET);\n  let rh='<div style=\"color:#888;font-size:12px;\">No data yet</div>';\n  if(g){ const rows=((g.standings&&g.standings.entries)||[]).map(en=>{let rank=99,pts='0';for(const s of en.stats){if(s.name==='rank')rank=parseInt(s.value);if(s.name==='points')pts=s.displayValue;}return{rank,abbr:en.team.abbreviation,flag:(en.team.logos&&en.team.logos[0]?en.team.logos[0].href:''),pts};}).sort((a,b)=>a.rank-b.rank);\n    rh=rows.map(r=>{const adv=r.rank<=2;return `<div style=\"display:flex;align-items:center;gap:8px;padding:4px 6px;border-left:3px solid ${adv?'#22c55e':'transparent'};background:${adv?'rgba(34,197,94,.12)':'transparent'};border-radius:4px;\"><span style=\"width:12px;color:${adv?'#22c55e':'#888'};font-weight:700;font-size:12px;\">${r.rank}</span>${flag(r.flag)}<span style=\"flex:1;color:#fff;font-size:13px;font-weight:${adv?'700':'500'};\">${esc(r.abbr)}</span><span style=\"color:#cbd5e1;font-weight:700;font-size:13px;\">${esc(r.pts)}</span></div>`;}).join(''); }\n  return `<div style=\"text-align:left;\"><div style=\"font-weight:800;color:#fff;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,.13);padding-bottom:4px;display:flex;justify-content:space-between;align-items:center;\">${TARGET}<span style=\"font-size:10px;opacity:.5;font-weight:500;\">tap ⓘ</span></div>${rh}</div>`;\n]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "rgba(30,30,30,.55)"
                          },
                          {
                            "border": "1px solid rgba(255,255,255,.1)"
                          },
                          {
                            "border-radius": "16px"
                          },
                          {
                            "padding": "12px"
                          },
                          {
                            "backdrop-filter": "blur(12px)"
                          },
                          {
                            "cursor": "pointer"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"content\""
                          },
                          {
                            "grid-template-columns": "1fr"
                          }
                        ],
                        "custom_fields": {
                          "content": [
                            {
                              "justify-self": "stretch"
                            },
                            {
                              "width": "100%"
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "## 🏆 Knockout Bracket\n_Auto-updates and redraws as teams qualify and games finish._"
                },
                {
                  "type": "custom:button-card",
                  "entity": "sensor.world_cup_schedule",
                  "triggers_update": [
                    "sensor.world_cup_schedule",
                    "sensor.world_cup_standings",
                    "sensor.world_cup_scoreboard"
                  ],
                  "show_icon": false,
                  "show_name": false,
                  "show_state": false,
                  "show_label": false,
                  "tap_action": {
                    "action": "none"
                  },
                  "custom_fields": {
                    "content": "[[[\n  const sch = states['sensor.world_cup_schedule'];\n  const stn = states['sensor.world_cup_standings'];\n  const all = (sch && sch.attributes && sch.attributes.matches) || [];\n  const groups = (stn && stn.attributes && stn.attributes.children) || [];\n  const esc = s => (s==null?'':String(s));\n  const flag = u => u ? `<img src=\"${u}\" style=\"height:20px;width:auto;border-radius:2px;margin-right:6px;vertical-align:middle;\">` : '<span style=\"display:inline-block;width:20px;margin-right:6px;\"></span>';\n\n  // current standings: group letter -> rank -> {ab, fl}\n  const gp={};\n  groups.forEach(g=>{ const L=(g.name||'').trim().slice(-1); gp[L]={};\n    ((g.standings&&g.standings.entries)||[]).forEach(en=>{ let rk=99; for(const s of en.stats){ if(s.name==='rank') rk=parseInt(s.value); }\n      gp[L][rk]={ab:en.team.abbreviation, fl:(en.team.logos&&en.team.logos[0]?en.team.logos[0].href:'')}; }); });\n  function project(ab){ const m=(ab||'').match(/^([12])([A-L])$/); if(m){ const t=gp[m[2]]&&gp[m[2]][+m[1]]; if(t&&t.ab) return t; } return null; }\n  function slot(ab,nm){\n    if(/^([12])([A-L])$/.test(ab||'')) return ab;\n    if(ab==='3RD') return '3rd place';\n    let m=(nm||'').match(/Round of (\\d+) (\\d+) Winner/); if(m) return 'R'+m[1]+'·W'+m[2];\n    return ab||nm||'TBD';\n  }\n\n  const byR={};\n  all.forEach(m=>{ if(m.rnd && m.rnd!=='group-stage'){ (byR[m.rnd]=byR[m.rnd]||[]).push(m); }});\n  Object.values(byR).forEach(a=>a.sort((x,y)=> x.d<y.d?-1:(x.d>y.d?1:0)));\n\n  function teamRow(m, side){\n    if(!m) return `<div style=\"display:flex;align-items:center;color:#7a8699;font-size:12px;padding:3px 7px;\">${flag('')}TBD</div>`;\n    const ab=side==='a'?m.a:m.h, nm=side==='a'?m.an:m.hn, fl=side==='a'?m.af:m.hf;\n    const sc=side==='a'?m.as:m.hs, osc=side==='a'?m.hs:m.as;\n    const win=m.s==='post' && sc!=null && osc!=null && parseInt(sc)>parseInt(osc);\n    const showScore=m.s!=='pre' && sc!=null;\n    let fh, label, style='';\n    if(fl){ fh=flag(fl); label=ab; }\n    else { const pr=project(ab);\n      if(pr){ fh=flag(pr.fl); label=pr.ab; style='opacity:.78;font-style:italic;'; }\n      else { fh=flag(''); label=slot(ab,nm); style='color:#9aa7bd;'; } }\n    return `<div style=\"display:flex;align-items:center;justify-content:space-between;padding:3px 7px;${win?'background:rgba(34,197,94,.16);':''}\">\n      <span style=\"display:flex;align-items:center;color:#fff;font-size:12px;font-weight:${win?'800':'500'};white-space:nowrap;${style}\">${fh}${esc(label)}</span>\n      <span style=\"color:#cbd5e1;font-size:12px;font-weight:700;margin-left:6px;\">${showScore?esc(sc):''}</span></div>`;\n  }\n  function box(m){\n    const live=m && m.s==='in';\n    const css=live?'border:1px solid #ef4444;box-shadow:0 0 10px rgba(239,68,68,.4);':'border:1px solid rgba(255,255,255,.12);';\n    let dl='';\n    if(m && m.d){ let dt; try{ dt=new Date(m.d).toLocaleString([], {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'}); }catch(e){ dt=m.d; }\n      dl=`<div style=\"text-align:center;color:#9aa7bd;font-size:10px;padding:2px 0;border-top:1px solid rgba(255,255,255,.08);\">🗓 ${dt}</div>`; }\n    return `<div style=\"background:rgba(18,20,30,.75);${css}border-radius:8px;width:154px;overflow:hidden;\">\n      ${teamRow(m,'a')}<div style=\"height:1px;background:rgba(255,255,255,.08);\"></div>${teamRow(m,'h')}${dl}</div>`;\n  }\n  function col(round, side, per){\n    const data=byR[round]||[]; const half=Math.ceil(data.length/2);\n    let slots = side==='c'? data.slice(0,per) : (side==='l'? data.slice(0,half) : data.slice(half));\n    let b=''; for(let i=0;i<per;i++) b+=box(slots[i]);\n    return `<div style=\"display:flex;flex:1;flex-direction:column;justify-content:space-around;\">${b}</div>`;\n  }\n  const hdr=t=>`<div style=\"text-align:center;color:#e2e8f0;font-weight:800;font-size:13px;letter-spacing:1px;margin-bottom:8px;\">${t}</div>`;\n  const cw=(l,i)=>`<div style=\"display:flex;flex-direction:column;min-width:162px;\">${hdr(l)}${i}</div>`;\n\n  const finalM=(byR['final']||[])[0];\n  let champ='<div style=\"font-size:42px;\">🏆</div>';\n  if(finalM && finalM.s==='post'){ const aw=parseInt(finalM.as),hw=parseInt(finalM.hs);\n    const w=aw>hw?{f:finalM.af,n:finalM.a}:(hw>aw?{f:finalM.hf,n:finalM.h}:null);\n    if(w&&w.f) champ=`<img src=\"${w.f}\" style=\"height:48px;border-radius:3px;\"><div style=\"color:#fff;font-weight:800;margin-top:4px;\">${esc(w.n)}</div>`; }\n\n  const left = cw('R32',col('round-of-32','l',8))+cw('R16',col('round-of-16','l',4))+cw('QF',col('quarterfinals','l',2))+cw('SF',col('semifinals','l',1));\n  const right = cw('SF',col('semifinals','r',1))+cw('QF',col('quarterfinals','r',2))+cw('R16',col('round-of-16','r',4))+cw('R32',col('round-of-32','r',8));\n  const center = `<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:172px;\">${hdr('FINAL')}${box(finalM)}<div style=\"margin-top:16px;text-align:center;\">${champ}</div><div style=\"color:#94a3b8;font-size:11px;font-weight:700;letter-spacing:1px;margin-top:6px;\">CHAMPION</div></div>`;\n\n  return `<div style=\"overflow-x:auto;padding:6px;\">\n    <div style=\"color:#94a3b8;font-size:11px;margin:0 0 6px 4px;\">📅 Group stage in progress — <i>italic = projected from current standings</i>; solid = clinched. Updates as games finish.</div>\n    <div style=\"display:flex;gap:14px;align-items:stretch;min-width:1620px;height:720px;\">${left}${center}${right}</div>\n  </div>`;\n]]]"
                  },
                  "styles": {
                    "card": [
                      {
                        "padding": "6px"
                      },
                      {
                        "background": "transparent"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "border": "none"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "\"content\""
                      },
                      {
                        "grid-template-columns": "1fr"
                      }
                    ],
                    "custom_fields": {
                      "content": [
                        {
                          "justify-self": "stretch"
                        },
                        {
                          "width": "100%"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "type": "panel"
        }
      ]
    }
  }
}