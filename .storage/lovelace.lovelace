                    "rows": 1
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "{% set scanned = states('sensor.tucson_last_scanned_at') %} {% if scanned not in ['unknown', 'unavailable', 'none', ''] %}\n  Retrieved {{ relative_time(as_datetime(scanned)) }} ago\n{% else %}\n  Retrieval time unavailable\n{% endif %}",
                  "secondary": "{% set updated = states('sensor.tucson_last_updated_at') %} {% if updated not in ['unknown', 'unavailable', 'none', ''] %}\n  Vehicle updated {{ relative_time(as_datetime(updated)) }} ago\n{% else %}\n  Vehicle update unavailable\n{% endif %}",
                  "icon": "mdi:cloud-sync",
                  "icon_color": "{% set scanned = states('sensor.tucson_last_scanned_at') %} {% if scanned in ['unknown', 'unavailable', 'none', ''] %}\n  disabled\n{% elif (as_timestamp(now()) - as_timestamp(scanned)) < 3600 %}\n  green\n{% elif (as_timestamp(now()) - as_timestamp(scanned)) < 14400 %}\n  amber\n{% else %}\n  red\n{% endif %}",
                  "multiline_secondary": true,
                  "grid_options": {
                    "columns": 8,
                    "rows": 2
                  }
                },
