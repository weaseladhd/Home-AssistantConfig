{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.lovelace",
  "data": {
    "config": {
      "apexcharts_card_templates": {
        "sun_elevation": {
          "series": [
            {
              "entity": "sensor.sun_elevation",
              "color": "rgb(255,255,255)",
              "opacity": 0.2,
              "stroke_width": 0.5,
              "yaxis_id": "sun",
              "unit": "°",
              "show": {
                "legend_value": false
              }
            },
            {
              "entity": "sensor.sun_elevation",
              "color": "rgb(255,255,255)",
              "opacity": 0.2,
              "stroke_width": 0.5,
              "yaxis_id": "sun",
              "unit": "°",
              "data_generator": "const now = new Date();\nconst data = [[now.getTime() - 172800000, 0], [now.getTime(), 0], [now.getTime() + 86400000, 0]];\nreturn data;\n"
            }
          ]
        },
        "environment_chart": {
          "header": {
            "show": false,
            "show_states": true,
            "colorize_states": true
          },
          "all_series_config": {
            "stroke_width": 2,
            "curve": "smooth",
            "extend_to": "now",
            "unit": ""
          },
          "graph_span": "48h",
          "span": {
            "start": "minute",
            "offset": "-36h"
          },
          "now": {
            "show": true
          },
          "yaxis": [
            {
              "id": "main",
              "show": true,
              "align_to": 5,
              "decimals": 0,
              "apex_config": {
                "labels": {
                  "offsetX": 24,
                  "offsetY": 2
                }
              }
            },
            {
              "id": "sun",
              "opposite": true,
              "min": -90,
              "max": 90,
              "show": false
            }
          ],
          "apex_config": {
            "legend": {
              "show": false
            },
            "dataLabels": {
              "textAnchor": "start",
              "formatter": "EVAL:function(value, { seriesIndex, dataPointIndex, w }) {\n  console.log(w.config)\n  if (dataPointIndex == w.config.series[seriesIndex].data.length - 2) {\n    return Math.round( value * 10 ) / 10 + \" - \" + w.config.series[seriesIndex].name  // + \" \" + dataPointIndex + \" \" + w.config.series[seriesIndex].data.length\n  } else { return '' }\n}\n",
              "offsetX": 4,
              "style": {
                "fontSize": "var(--h6-font-size)",
                "fontFamily": "var(--font-stack)",
                "fontWeight": 500
              },
              "background": {
                "borderRadius": 0,
                "borderWidth": 0,
                "opacity": 1
              }
            },
            "xaxis": {
              "axisBorder": {
                "show": false
              },
              "axisTicks": {
                "show": true,
                "color": "rgba(var(--rgb-primary-text-color),.075)",
                "height": 40
              },
              "labels": {
                "show": true,
                "style": {
                  "fontSize": "var(--h6-font-size)",
                  "fontFamily": "var(--font-stack)"
                }
              },
              "tooltip": {
                "enabled": false,
                "offsetY": -100,
                "style": {
                  "fontSize": "var(--body-font-size)",
                  "fontFamily": "var(--font-stack)"
                }
              }
            },
            "yaxis": {
              "labels": {
                "minWidth": 160,
                "offsetX": 50,
                "style": {
                  "fontSize": "var(--h6-font-size)",
                  "fontFamily": "var(--font-stack)"
                }
              },
              "tooltip": {
                "enabled": true,
                "offsetX": 40
              }
            },
            "grid": {
              "strokeDashArray": "1,2",
              "borderColor": "rgba(var(--rgb-primary-text-color),.25)",
              "xaxis": {
                "lines": {
                  "show": true
                }
              },
              "yaxis": {
                "lines": {
                  "show": true
                }
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            },
            "tooltip": {
              "style": {
                "fontSize": "var(--body-font-size)",
                "fontFamily": "var(--font-stack)"
              }
            },
            "forecastDataPoints": {
              "strokeWidth": 1,
              "dashArray": "2,2"
            }
          },
          "card_mod": {
            "style": "#graph {margin-left: -26px; margin-top: -16px;} .apexcharts-yaxis-label { font-family: var(--font-stack) !important;\n  font-size: var(--h6-font-size) !important;\n  opacity: 0.15;}\n.apexcharts-yaxis-label:nth-child(5n+1) { opacity: .5;} .apexcharts-xaxis-label { opacity: .5; transform: translate(0, -2px); } .apexcharts-xaxis-annotation-label { font-family: var(--font-stack) !important;\n  font-size: var(--h6-font-size) !important; font-weight: 500 !important;}\n.apexcharts-point-annotation-label { font-family: var(--font-stack) !important;\n  font-size: var(--h6-font-size) !important; font-weight: normal !important;}\n"
          }
        }
      },
      "button_card_templates": {
        "wc_group_card": {
          "entity": "sensor.world_cup_standings",
          "triggers_update": [
            "sensor.world_cup_standings"
          ],
          "show_icon": false,
          "show_name": false,
          "show_state": false,
          "show_label": false,
          "variables": {
            "group": "A",
            "favorite_team": "NED"
          },
          "tap_action": {
            "action": "fire-dom-event",
            "browser_mod": {
              "service": "browser_mod.popup",
              "data": {
                "title": "[[[ return \"Group \" + String(variables.group || \"A\").replace(/^Group\\s*/i, \"\").trim().toUpperCase(); ]]]",
                "content": {
                  "type": "custom:button-card",
                  "template": "wc_group_popup",
                  "variables": {
                    "group": "[[[ return variables.group; ]]]",
                    "favorite_team": "[[[ return variables.favorite_team || 'NED'; ]]]"
                  }
                }
              }
            }
          },
          "hold_action": {
            "action": "none"
          },
          "double_tap_action": {
            "action": "none"
          },
          "custom_fields": {
            "content": "[[[\n  const st = states['sensor.world_cup_standings'];\n  const groups = (st && st.attributes && st.attributes.children) || [];\n\n  const GROUP = String(variables.group || 'A').replace(/^Group\\s*/i, '').trim().toUpperCase();\n  const TARGET = `Group ${GROUP}`;\n  const FAV = String(variables.favorite_team || 'NED').toUpperCase();\n\n  const esc = s => (s == null ? '' : String(s));\n\n  const flag = u => u\n    ? `<img src=\"${u}\" class=\"wc-group-flag-img\">`\n    : '';\n\n  function statValue(entry, names, fallback = '') {\n    const wanted = names.map(x => String(x).toLowerCase());\n\n    for (const s of (entry.stats || [])) {\n      const keys = [\n        s.name,\n        s.displayName,\n        s.shortDisplayName,\n        s.abbreviation\n      ].filter(Boolean).map(x => String(x).toLowerCase());\n\n      if (keys.some(k => wanted.includes(k))) {\n        return s.displayValue ?? s.value ?? fallback;\n      }\n    }\n\n    return fallback;\n  }\n\n  function statNumber(entry, names, fallback = 0) {\n    const raw = statValue(entry, names, fallback);\n    const n = Number(raw);\n\n    return Number.isFinite(n) ? n : fallback;\n  }\n\n  const group = groups.find(x => x.name === TARGET);\n\n  let rowsHtml = `\n    <div class=\"wc-group-empty\">\n      No data yet\n    </div>\n  `;\n\n  if (group) {\n    const rows = ((group.standings && group.standings.entries) || []).map(entry => {\n      const team = entry.team || {};\n      const rank = statNumber(entry, ['rank', 'position'], 99);\n      const pts = statValue(entry, ['points', 'pts', 'p'], '0');\n      const played = statValue(entry, ['gamesplayed', 'played', 'gp', 'pld'], '');\n      const gd = statValue(entry, ['pointdifferential', 'goaldifference', 'goal difference', 'gd'], '');\n\n      return {\n        rank,\n        abbr: team.abbreviation || '',\n        name: team.shortDisplayName || team.displayName || team.name || team.abbreviation || '',\n        flag: team.logos && team.logos[0] ? team.logos[0].href : '',\n        pts,\n        played,\n        gd\n      };\n    }).sort((a, b) => a.rank - b.rank);\n\n    rowsHtml = rows.map(r => {\n      const advance = r.rank <= 2;\n      const chance = r.rank === 3;\n      const dim = r.rank >= 4;\n      const fav = String(r.abbr || '').toUpperCase() === FAV;\n\n      const classes = [\n        'wc-group-row',\n        advance ? 'wc-group-row-advance' : '',\n        chance ? 'wc-group-row-chance' : '',\n        dim ? 'wc-group-row-dim' : ''\n      ].filter(Boolean).join(' ');\n      \n      const favStar = fav\n        ? `<span class=\"wc-fav-star\" title=\"Favorite team\">★</span>`\n        : '';\n\n      const gdText = r.gd !== '' ? `<span class=\"wc-group-gd\">${esc(r.gd)}</span>` : '';\n      const playedText = r.played !== '' ? `<span class=\"wc-group-played\">${esc(r.played)}</span>` : '';\n\n      return `\n        <div class=\"${classes}\">\n          <span class=\"wc-group-rank\">${esc(r.rank)}</span>\n\n          <span class=\"wc-group-flag\">\n            ${flag(r.flag)}\n          </span>\n\n          <span class=\"wc-group-team\" title=\"${esc(r.name)}\">\n            ${esc(r.abbr || r.name)}\n            ${favStar}\n          </span>\n\n          <span class=\"wc-group-extra\">\n            ${playedText}\n            ${gdText}\n          </span>\n\n          <span class=\"wc-group-points\">\n            ${esc(r.pts)}\n          </span>\n        </div>\n      `;\n    }).join('');\n  }\n\n  return `\n    <style>\n      .wc-group-wrap {\n        width: 100%;\n        max-width: 100%;\n        min-width: 0;\n        overflow: hidden;\n        box-sizing: border-box;\n        text-align: left;\n      }\n\n      .wc-group-head {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 8px;\n        padding-bottom: 8px;\n        margin-bottom: 4px;\n        border-bottom: 1px solid rgba(255,255,255,.10);\n        min-width: 0;\n      }\n\n      .wc-group-title-wrap {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        min-width: 0;\n        flex: 1 1 auto;\n      }\n\n      .wc-group-accent {\n        width: 7px;\n        height: 24px;\n        border-radius: 999px;\n        background: linear-gradient(180deg, rgba(34,197,94,.95), rgba(34,197,94,.18));\n        box-shadow: 0 0 14px rgba(34,197,94,.20);\n        flex: 0 0 7px;\n      }\n\n      .wc-group-title-text {\n        min-width: 0;\n      }\n\n      .wc-group-title {\n        color: #f8fafc;\n        font-weight: 900;\n        font-size: 15px;\n        letter-spacing: .2px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-group-subtitle {\n        color: #94a3b8;\n        font-size: 10px;\n        font-weight: 750;\n        margin-top: 1px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-info-icon {\n        width: 22px;\n        height: 22px;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        border-radius: 999px;\n        color: #94a3b8;\n        background: rgba(148,163,184,.10);\n        border: 1px solid rgba(148,163,184,.16);\n        font-size: 13px;\n        font-weight: 900;\n        flex: 0 0 22px;\n      }\n\n      .wc-group-row {\n        display: flex;\n        align-items: center;\n        gap: 6px;\n        padding: 7px 7px;\n        margin-top: 5px;\n        border-radius: 10px;\n        box-sizing: border-box;\n        min-width: 0;\n        overflow: hidden;\n        background: rgba(17,19,33,.34);\n        border: 1px solid rgba(255,255,255,.06);\n        border-left: 3px solid rgba(148,163,184,.22);\n        transition:\n          background .2s ease,\n          border-color .2s ease,\n          opacity .2s ease,\n          filter .2s ease;\n      }\n\n      .wc-group-row-advance {\n        background: linear-gradient(90deg, rgba(34,197,94,.13), rgba(34,197,94,.035));\n        border-color: rgba(34,197,94,.18);\n        border-left-color: rgba(34,197,94,.78);\n      }\n\n      .wc-group-row-chance {\n        background: linear-gradient(90deg, rgba(245,158,11,.11), rgba(245,158,11,.025));\n        border-color: rgba(245,158,11,.16);\n        border-left-color: rgba(245,158,11,.72);\n      }\n\n      .wc-group-row-dim {\n        opacity: .82;\n      }\n\n      .wc-group-row-fav {\n        border-color: rgba(249,115,22,.28);\n        border-left-color: rgba(249,115,22,.85);\n        box-shadow: inset 0 0 14px rgba(249,115,22,.06);\n      }\n\n      .wc-group-rank {\n        width: 18px;\n        height: 18px;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        border-radius: 999px;\n        color: #94a3b8;\n        background: rgba(148,163,184,.10);\n        font-weight: 900;\n        font-size: 11px;\n        flex: 0 0 18px;\n      }\n\n      .wc-group-row-advance .wc-group-rank {\n        color: #86efac;\n        background: rgba(34,197,94,.15);\n      }\n\n      .wc-group-row-chance .wc-group-rank {\n        color: #fde68a;\n        background: rgba(245,158,11,.13);\n      }\n\n      .wc-group-row-fav .wc-group-rank {\n        color: #fed7aa;\n        background: rgba(249,115,22,.14);\n      }\n\n      .wc-group-flag {\n        flex: 0 0 auto;\n        display: inline-flex;\n        align-items: center;\n      }\n\n      .wc-group-flag-img {\n        height: 18px;\n        width: auto;\n        vertical-align: middle;\n        border-radius: 3px;\n      }\n\n      .wc-group-team {\n        flex: 1 1 auto;\n        min-width: 0;\n        color: #f8fafc;\n        font-size: 13px;\n        font-weight: 800;\n        font-style: italic;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-group-row-advance .wc-group-team {\n        font-weight: 900;\n      }\n\n      .wc-group-row-fav .wc-group-team {\n        color: #fed7aa;\n        font-weight: 950;\n      }\n\n      .wc-group-extra {\n        display: flex;\n        align-items: center;\n        gap: 4px;\n        flex: 0 0 auto;\n        min-width: 0;\n      }\n\n      .wc-group-played,\n      .wc-group-gd {\n        color: #94a3b8;\n        background: rgba(255,255,255,.055);\n        border: 1px solid rgba(255,255,255,.07);\n        border-radius: 999px;\n        padding: 2px 6px;\n        font-size: 10px;\n        font-weight: 850;\n        line-height: 1;\n        white-space: nowrap;\n      }\n\n      .wc-group-gd {\n        display: none;\n      }\n\n      .wc-group-points {\n        color: #e2e8f0;\n        background: rgba(255,255,255,.08);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 999px;\n        padding: 2px 7px;\n        font-weight: 900;\n        font-size: 12px;\n        flex: 0 0 auto;\n        min-width: 22px;\n        text-align: center;\n        white-space: nowrap;\n      }\n\n      .wc-group-row-advance .wc-group-points {\n        color: #bbf7d0;\n        background: rgba(34,197,94,.12);\n        border-color: rgba(34,197,94,.18);\n      }\n\n      .wc-group-row-chance .wc-group-points {\n        color: #fde68a;\n        background: rgba(245,158,11,.11);\n        border-color: rgba(245,158,11,.16);\n      }\n\n      .wc-group-row-fav .wc-group-points {\n        color: #fed7aa;\n        background: rgba(249,115,22,.12);\n        border-color: rgba(249,115,22,.18);\n      }\n\n      .wc-group-empty {\n        color: #94a3b8;\n        font-size: 12px;\n        padding: 8px;\n        background: rgba(17,19,33,.34);\n        border: 1px solid rgba(255,255,255,.06);\n        border-radius: 10px;\n      }\n\n      .wc-fav-star {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        margin-left: 5px;\n        color: #fde047;\n        font-size: 12px;\n        font-style: normal;\n        font-weight: 950;\n        line-height: 1;\n        text-shadow: 0 0 8px rgba(250,204,21,.45);\n        flex: 0 0 auto;\n      }\n\n      @media (max-width: 520px) {\n        .wc-info-icon {\n          width: 20px;\n          height: 20px;\n          flex-basis: 20px;\n          font-size: 12px;\n        }\n\n        .wc-group-row {\n          gap: 5px;\n          padding: 6px 6px;\n        }\n\n        .wc-group-points {\n          padding: 2px 6px;\n          font-size: 11px;\n          min-width: 20px;\n        }\n\n        .wc-group-rank {\n          width: 17px;\n          height: 17px;\n          flex-basis: 17px;\n        }\n\n        .wc-group-played,\n        .wc-group-gd {\n          display: none;\n        }\n      }\n\n      @media (max-width: 380px) {\n        .wc-group-flag-img {\n          height: 16px;\n        }\n\n        .wc-group-title {\n          font-size: 14px;\n        }\n\n        .wc-group-accent {\n          height: 20px;\n        }\n\n        .wc-group-row {\n          gap: 4px;\n          padding: 6px 5px;\n        }\n      }\n    </style>\n\n    <div class=\"wc-group-wrap\">\n      <div class=\"wc-group-head\">\n        <div class=\"wc-group-title-wrap\">\n          <span class=\"wc-group-accent\"></span>\n\n          <div class=\"wc-group-title-text\">\n            <div class=\"wc-group-title\">${TARGET}</div>\n            <div class=\"wc-group-subtitle\">Top 2 advance</div>\n          </div>\n        </div>\n\n        <div class=\"wc-info-icon\">ⓘ</div>\n      </div>\n\n      ${rowsHtml}\n    </div>\n  `;\n]]]"
          },
          "styles": {
            "card": [
              {
                "background": "linear-gradient(145deg, rgba(30,32,46,.68), rgba(17,19,33,.58))"
              },
              {
                "border": "1px solid rgba(255,255,255,.10)"
              },
              {
                "border-radius": "18px"
              },
              {
                "padding": "10px"
              },
              {
                "backdrop-filter": "blur(12px)"
              },
              {
                "box-shadow": "0 10px 28px rgba(0,0,0,.22)"
              },
              {
                "cursor": "pointer"
              },
              {
                "transition": "transform .15s ease, border-color .15s ease, box-shadow .15s ease"
              },
              {
                "min-width": 0
              },
              {
                "overflow": "hidden"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"content\""
              },
              {
                "grid-template-columns": "1fr"
              },
              {
                "min-width": 0
              }
            ],
            "custom_fields": {
              "content": [
                {
                  "justify-self": "stretch"
                },
                {
                  "width": "100%"
                },
                {
                  "min-width": 0
                },
                {
                  "overflow": "hidden"
                }
              ]
            }
          }
        },
        "wc_group_popup": {
          "entity": "sensor.world_cup_schedule",
          "triggers_update": [
            "sensor.world_cup_schedule",
            "sensor.world_cup_scoreboard",
            "sensor.world_cup_standings"
          ],
          "show_icon": false,
          "show_name": false,
          "show_state": false,
          "show_label": false,
          "variables": {
            "group": "A",
            "favorite_team": "NED"
          },
          "tap_action": {
            "action": "none"
          },
          "hold_action": {
            "action": "none"
          },
          "double_tap_action": {
            "action": "none"
          },
          "custom_fields": {
            "content": "[[[\n  const st = states['sensor.world_cup_standings'];\n  const sch = states['sensor.world_cup_schedule'];\n  const sb = states['sensor.world_cup_scoreboard'];\n\n  const GROUP = String(variables.group || 'A').replace(/^Group\\s*/i, '').trim().toUpperCase();\n  const TARGET = `Group ${GROUP}`;\n  const FAV = String(variables.favorite_team || 'NED').toUpperCase();\n\n  const esc = s => (s == null ? '' : String(s));\n\n  const calendarIcon = `\n    <svg class=\"wc-popup-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1.5A2.5 2.5 0 0 1 22 6.5v12A2.5 2.5 0 0 1 19.5 21h-15A2.5 2.5 0 0 1 2 18.5v-12A2.5 2.5 0 0 1 4.5 4H6V3a1 1 0 0 1 1-1Zm12.5 8h-15v8.5a.5.5 0 0 0 .5.5h14a.5.5 0 0 0 .5-.5V10ZM5 6a.5.5 0 0 0-.5.5V8h15V6.5A.5.5 0 0 0 19 6H5Z\"/>\n    </svg>\n  `;\n\n  const locationIcon = `\n    <svg class=\"wc-popup-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z\"/>\n    </svg>\n  `;\n\n  const fmt = iso => {\n    try {\n      return new Date(iso).toLocaleString([], {\n        weekday: 'short',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    } catch(e) {\n      return esc(iso);\n    }\n  };\n\n  const flag = u => u\n    ? `<img src=\"${u}\" class=\"wc-popup-flag\">`\n    : '';\n\n  function scoreValue(raw) {\n    if (raw == null || raw === '') return '';\n\n    if (typeof raw === 'object') {\n      return raw.displayValue ?? raw.value ?? raw.score ?? '';\n    }\n\n    return raw;\n  }\n\n  function scoreNumber(raw) {\n    const val = scoreValue(raw);\n\n    if (val === '') return null;\n\n    const n = Number(val);\n\n    return Number.isFinite(n) ? n : null;\n  }\n\n  function venueText(m) {\n    if (!m) return '';\n\n    if (m.v) return String(m.v);\n\n    const rawVenue = m.venue || m.location || {};\n\n    if (typeof rawVenue === 'string') return rawVenue;\n\n    if (rawVenue && typeof rawVenue === 'object') {\n      const address = rawVenue.address || {};\n\n      return [\n        rawVenue.fullName || rawVenue.name || rawVenue.displayName || rawVenue.shortName,\n        address.city || rawVenue.city || rawVenue.venueCity,\n        address.country || rawVenue.country || rawVenue.venueCountry\n      ].filter(x => x && String(x).trim()).join(', ');\n    }\n\n    return [\n      m.venueName,\n      m.venue_name,\n      m.stadium,\n      m.stadiumName,\n      m.city,\n      m.country\n    ].filter(x => x && String(x).trim()).join(', ');\n  }\n\n  function resultInfo(m) {\n    if (!m || m.s !== 'post') {\n      return {\n        result: 'none',\n        awayClass: '',\n        homeClass: '',\n        scoreClass: ''\n      };\n    }\n\n    const away = scoreNumber(m.as);\n    const home = scoreNumber(m.hs);\n\n    if (away === null || home === null) {\n      return {\n        result: 'none',\n        awayClass: '',\n        homeClass: '',\n        scoreClass: ''\n      };\n    }\n\n    if (away === home) {\n      return {\n        result: 'draw',\n        awayClass: 'wc-popup-team-draw',\n        homeClass: 'wc-popup-team-draw',\n        scoreClass: 'wc-popup-score-draw'\n      };\n    }\n\n    if (away > home) {\n      return {\n        result: 'away-win',\n        awayClass: 'wc-popup-team-win',\n        homeClass: 'wc-popup-team-loss',\n        scoreClass: 'wc-popup-score-finished'\n      };\n    }\n\n    return {\n      result: 'home-win',\n      awayClass: 'wc-popup-team-loss',\n      homeClass: 'wc-popup-team-win',\n      scoreClass: 'wc-popup-score-finished'\n    };\n  }\n\n  function statusBadge(m, result) {\n    if (m.s === 'in') return `<span class=\"wc-status wc-live\">LIVE</span>`;\n    if (m.s === 'post' && result === 'draw') return `<span class=\"wc-status wc-draw\">DRAW</span>`;\n    if (m.s === 'post') return `<span class=\"wc-status wc-finished\">FINISHED</span>`;\n    return `<span class=\"wc-status wc-scheduled\">SCHEDULED</span>`;\n  }\n\n  function teamLine(flagUrl, abbr, score, showScore, resultClass, scoreClass) {\n    const fav = String(abbr || '').toUpperCase() === FAV;\n    \n    const favStar = fav\n      ? `<span class=\"wc-fav-star wc-fav-star-popup\" title=\"Favorite team\">★</span>`\n      : '';\n    \n    return `\n      <div class=\"wc-popup-team ${resultClass}\">\n        <div class=\"wc-popup-team-name\">\n          ${flag(flagUrl)}${esc(abbr)}${favStar}\n        </div>\n\n        <div class=\"wc-popup-score ${scoreClass}\">\n          ${showScore ? esc(scoreValue(score)) : ''}\n        </div>\n      </div>\n    `;\n  }\n\n  const groups = (st && st.attributes && st.attributes.children) || [];\n  const group = groups.find(x => x.name === TARGET);\n\n  const teams = group\n    ? ((group.standings && group.standings.entries) || []).map(e => e.team.abbreviation)\n    : [];\n\n  let matches = (sch && sch.attributes && sch.attributes.matches) || [];\n\n  if (!matches.length && sb) {\n    matches = ((sb.attributes && sb.attributes.events) || []).map(e => {\n      const c = e.competitions && e.competitions[0];\n      const cs = (c && c.competitors) || [];\n      const h = cs.find(x => x.homeAway === 'home') || {};\n      const a = cs.find(x => x.homeAway === 'away') || {};\n      const v = (c && c.venue) || {};\n      const ad = v.address || {};\n\n      return {\n        d: e.date,\n        a: a.team && a.team.abbreviation,\n        h: h.team && h.team.abbreviation,\n        af: (a.team && a.team.logo) || '',\n        hf: (h.team && h.team.logo) || '',\n        as: scoreValue(a.score),\n        hs: scoreValue(h.score),\n        s: e.status && e.status.type && e.status.type.state,\n        det: e.status && e.status.type && e.status.type.shortDetail,\n        v: [v.fullName, ad.city, ad.country].filter(Boolean).join(', ')\n      };\n    });\n  }\n\n  const groupMatches = matches\n    .filter(m => teams.includes(m.a) || teams.includes(m.h))\n    .sort((x, y) => x.d < y.d ? -1 : (x.d > y.d ? 1 : 0));\n\n  function matchdayNumber(m, index) {\n    const raw = m.matchday || m.matchDay || m.md || m.roundNumber || '';\n\n    const n = parseInt(String(raw).replace(/\\D/g, ''));\n\n    if (Number.isFinite(n) && n > 0) return n;\n\n    return Math.floor(index / 2) + 1;\n  }\n\n  const matchdays = {};\n\n  groupMatches.forEach((m, index) => {\n    const md = matchdayNumber(m, index);\n    matchdays[md] = matchdays[md] || [];\n    matchdays[md].push(m);\n  });\n\n  const body = groupMatches.length\n    ? Object.keys(matchdays)\n        .map(x => Number(x))\n        .sort((a, b) => a - b)\n        .map(md => {\n          const fixtures = matchdays[md].map(m => {\n            const showScore = m.s !== 'pre' && m.as != null && m.hs != null;\n            const live = m.s === 'in';\n            const result = resultInfo(m);\n            const venue = venueText(m);\n\n            return `\n              <div class=\"wc-popup-match ${live ? 'wc-popup-match-live' : ''}\">\n                <div class=\"wc-popup-meta\">\n                  <div class=\"wc-popup-date\">\n                    ${calendarIcon}\n                    <span>${fmt(m.d)}</span>\n                  </div>\n\n                  ${statusBadge(m, result.result)}\n                </div>\n\n                <div class=\"wc-popup-scorebox\">\n                  ${teamLine(m.af, m.a, m.as, showScore, result.awayClass, result.scoreClass)}\n                  <div class=\"wc-divider\"></div>\n                  ${teamLine(m.hf, m.h, m.hs, showScore, result.homeClass, result.scoreClass)}\n                </div>\n\n                <div class=\"wc-popup-venue\">\n                  ${locationIcon}\n                  <span>${esc(venue || 'Venue TBD')}</span>\n                </div>\n              </div>\n            `;\n          }).join('');\n\n          return `\n            <div class=\"wc-matchday-block\">\n              <div class=\"wc-matchday-title\">Matchday ${md}</div>\n              ${fixtures}\n            </div>\n          `;\n        }).join('')\n    : `\n      <div class=\"wc-popup-empty\">\n        No fixtures found.\n      </div>\n    `;\n\n  return `\n    <style>\n      .wc-popup-shell {\n        pointer-events: auto !important;\n        text-align: left;\n        width: 100%;\n        max-width: 720px;\n        margin: 0 auto;\n        padding: 2px 4px 2px 2px;\n        box-sizing: border-box;\n        overflow: visible;\n        position: relative;\n        z-index: 10;\n      }\n\n      .wc-popup-scroll {\n        pointer-events: auto !important;\n        width: 100%;\n        max-width: 100%;\n        box-sizing: border-box;\n        overflow: visible;\n        touch-action: auto;\n      }\n\n      .wc-popup-title {\n        color: #f8fafc;\n        font-weight: 900;\n        font-size: 15px;\n        margin-bottom: 8px;\n        letter-spacing: .2px;\n      }\n\n      .wc-matchday-title {\n        color: #cbd5e1;\n        font-size: 12px;\n        font-weight: 950;\n        letter-spacing: .4px;\n        text-transform: uppercase;\n        margin: 10px 0 6px 2px;\n        padding-left: 8px;\n        border-left: 3px solid rgba(148,163,184,.45);\n      }\n\n      .wc-matchday-block:first-of-type .wc-matchday-title {\n        margin-top: 0;\n      }\n\n      .wc-popup-match {\n        background: rgba(24,26,36,.72);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 12px;\n        padding: 6px;\n        margin-bottom: 8px;\n        box-sizing: border-box;\n        min-width: 0;\n        overflow: hidden;\n      }\n\n      .wc-popup-match-live {\n        border-color: rgba(239,68,68,.42);\n        box-shadow: 0 0 12px rgba(239,68,68,.16);\n      }\n\n      .wc-popup-meta {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 8px;\n        margin-bottom: 5px;\n        padding: 0 2px;\n        min-width: 0;\n      }\n\n      .wc-popup-date {\n        display: flex;\n        align-items: center;\n        gap: 5px;\n        color: #cbd5e1;\n        font-size: 11px;\n        font-weight: 650;\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        white-space: nowrap;\n      }\n\n      .wc-popup-icon {\n        width: 12px;\n        height: 12px;\n        fill: currentColor;\n        flex: 0 0 auto;\n        opacity: .78;\n      }\n\n      .wc-status {\n        border-radius: 999px;\n        padding: 2px 6px;\n        font-size: 10px;\n        font-weight: 850;\n        letter-spacing: .2px;\n        white-space: nowrap;\n        flex: 0 0 auto;\n      }\n\n      .wc-finished {\n        background: rgba(34,197,94,.12);\n        color: #86efac;\n        border: 1px solid rgba(34,197,94,.22);\n      }\n\n      .wc-live {\n        background: rgba(239,68,68,.12);\n        color: #fca5a5;\n        border: 1px solid rgba(239,68,68,.28);\n      }\n\n      .wc-draw {\n        background: rgba(245,158,11,.12);\n        color: #fde68a;\n        border: 1px solid rgba(245,158,11,.24);\n      }\n\n      .wc-scheduled {\n        background: rgba(148,163,184,.10);\n        color: #cbd5e1;\n        border: 1px solid rgba(148,163,184,.16);\n      }\n\n      .wc-popup-scorebox {\n        background: rgba(17,19,33,.62);\n        border: 1px solid rgba(255,255,255,.06);\n        border-radius: 9px;\n        overflow: hidden;\n      }\n\n      .wc-popup-team {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 8px;\n        padding: 6px 8px;\n        min-width: 0;\n        border-radius: 0;\n        border: 1px solid transparent;\n        box-sizing: border-box;\n      }\n\n      .wc-popup-team-name {\n        display: flex;\n        align-items: center;\n        min-width: 0;\n        color: #f8fafc;\n        font-size: 13px;\n        font-weight: 750;\n        font-style: italic;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-popup-team-win {\n        background: rgba(34,197,94,.14);\n        border-color: rgba(34,197,94,.22);\n        box-shadow: inset 0 0 12px rgba(34,197,94,.07);\n      }\n\n      .wc-popup-team-win .wc-popup-team-name {\n        color: #bbf7d0;\n        font-weight: 900;\n      }\n\n      .wc-popup-team-loss {\n        background: rgba(127,29,29,.16);\n        border-color: rgba(239,68,68,.15);\n        opacity: .68;\n        filter: saturate(.78) brightness(.88);\n      }\n\n      .wc-popup-team-loss .wc-popup-team-name {\n        color: #fecaca;\n      }\n\n      .wc-popup-team-draw {\n        background: rgba(245,158,11,.11);\n        border-color: rgba(245,158,11,.20);\n      }\n\n      .wc-popup-team-draw .wc-popup-team-name {\n        color: #fde68a;\n        font-weight: 850;\n      }\n\n      .wc-popup-team-fav {\n        box-shadow: inset 4px 0 0 rgba(249,115,22,.48);\n      }\n\n      .wc-popup-team-fav .wc-popup-team-name {\n        color: #fed7aa;\n      }\n\n      .wc-popup-flag {\n        height: 16px;\n        width: auto;\n        border-radius: 2px;\n        margin-right: 6px;\n        vertical-align: middle;\n        flex: 0 0 auto;\n      }\n\n      .wc-popup-score {\n        color: #e2e8f0;\n        font-size: 13px;\n        font-weight: 850;\n        min-width: 20px;\n        text-align: right;\n      }\n\n      .wc-popup-score-finished {\n        color: #f8fafc;\n        font-weight: 950;\n      }\n\n      .wc-popup-score-draw {\n        color: #fde68a;\n        font-weight: 950;\n      }\n\n      .wc-divider {\n        height: 1px;\n        background: rgba(255,255,255,.06);\n      }\n\n      .wc-popup-venue {\n        display: flex;\n        align-items: center;\n        gap: 5px;\n        color: #94a3b8;\n        font-size: 11px;\n        margin-top: 5px;\n        padding: 0 2px;\n        min-width: 0;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-popup-venue span {\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-popup-empty {\n        color: #94a3b8;\n        background: rgba(24,26,36,.55);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 12px;\n        padding: 10px;\n        font-size: 12px;\n      }\n\n      .wc-fav-star {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        margin-left: 5px;\n        color: #fde047;\n        font-size: 12px;\n        font-style: normal;\n        font-weight: 950;\n        line-height: 1;\n        text-shadow: 0 0 8px rgba(250,204,21,.45);\n        flex: 0 0 auto;\n      }\n      \n      .wc-fav-star-popup {\n        font-size: 11px;\n      }\n\n      @media (max-width: 520px), (max-height: 760px) {\n        .wc-popup-shell {\n          padding: 0;\n        }\n\n        .wc-popup-scroll {\n          max-height: calc(100dvh - 180px);\n          overflow-y: scroll !important;\n          overflow-x: hidden !important;\n          padding-right: 10px;\n          box-sizing: border-box;\n          scrollbar-width: auto;\n          scrollbar-gutter: stable;\n          -webkit-overflow-scrolling: touch;\n          overscroll-behavior: contain;\n          touch-action: pan-y !important;\n          position: relative;\n          z-index: 20;\n        }\n\n        .wc-popup-scroll::-webkit-scrollbar {\n          width: 14px;\n        }\n\n        .wc-popup-scroll::-webkit-scrollbar-thumb {\n          background: rgba(148,163,184,.55);\n          border-radius: 999px;\n          border: 3px solid rgba(17,19,33,.95);\n        }\n\n        .wc-popup-scroll::-webkit-scrollbar-track {\n          background: rgba(255,255,255,.06);\n          border-radius: 999px;\n        }\n      }\n\n      @media (max-width: 420px) {\n        .wc-popup-scroll {\n          max-height: calc(100dvh - 150px);\n          padding-right: 8px;\n        }\n\n        .wc-popup-title {\n          font-size: 14px;\n        }\n\n        .wc-popup-date {\n          font-size: 10px;\n        }\n\n        .wc-status {\n          font-size: 9px;\n          padding: 2px 5px;\n        }\n\n        .wc-popup-team-name,\n        .wc-popup-score {\n          font-size: 12px;\n        }\n\n        .wc-popup-venue {\n          font-size: 10px;\n        }\n      }\n    </style>\n\n    <div class=\"wc-popup-shell\">\n      <div class=\"wc-popup-scroll\">\n        <div class=\"wc-popup-title\">${TARGET} fixtures</div>\n        ${body}\n      </div>\n    </div>\n  `;\n]]]"
          },
          "styles": {
            "card": [
              {
                "background": "transparent"
              },
              {
                "box-shadow": "none"
              },
              {
                "border": "none"
              },
              {
                "padding": 0
              },
              {
                "overflow": "visible"
              },
              {
                "pointer-events": "none"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"content\""
              },
              {
                "grid-template-columns": "1fr"
              },
              {
                "overflow": "visible"
              },
              {
                "pointer-events": "none"
              }
            ],
            "custom_fields": {
              "content": [
                {
                  "justify-self": "stretch"
                },
                {
                  "width": "100%"
                },
                {
                  "min-width": 0
                },
                {
                  "overflow": "visible"
                },
                {
                  "pointer-events": "auto"
                }
              ]
            }
          }
        },
        "wc_match_strip": {
          "entity": "sensor.world_cup_schedule",
          "triggers_update": [
            "sensor.world_cup_schedule",
            "sensor.world_cup_scoreboard"
          ],
          "show_icon": false,
          "show_name": false,
          "show_state": false,
          "show_label": false,
          "variables": {
            "mode": "today",
            "limit": 8,
            "hide_if_empty": false,
            "match_timezone": "America/New_York",
            "show_today": false,
            "row_max_width": 2000,
            "card_min_width": 280,
            "card_max_width": 450
          },
          "tap_action": {
            "action": "none"
          },
          "hold_action": {
            "action": "none"
          },
          "double_tap_action": {
            "action": "none"
          },
          "custom_fields": {
            "content": "[[[\n  const sch = states['sensor.world_cup_schedule'];\n  const sb = states['sensor.world_cup_scoreboard'];\n\n  const scheduleRaw = (sch && sch.attributes && sch.attributes.matches) || [];\n  const events = (sb && sb.attributes && sb.attributes.events) || [];\n\n  const MODE = String(variables.mode || 'today').toLowerCase();\n  const LIMIT = Number(variables.limit || 8);\n\n  const MATCH_TZ = String(variables.match_timezone || 'America/New_York');\n  const SHOW_TODAY = variables.show_today === true || variables.show_today === 'true';\n\n  const CARD_WIDTH = Math.max(220, Number(variables.card_width || 360));\n\n  const esc = s => (s == null ? '' : String(s));\n\n  const locationIcon = `\n    <svg class=\"wc-score-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z\"/>\n    </svg>\n  `;\n\n  const flag = u => u\n    ? `<img src=\"${u}\" class=\"wc-score-flag\">`\n    : '';\n\n  function scoreValue(raw) {\n    if (raw == null || raw === '') return '';\n\n    if (typeof raw === 'object') {\n      return raw.displayValue ?? raw.value ?? raw.score ?? '';\n    }\n\n    return raw;\n  }\n\n  function scoreNumber(raw) {\n    const val = scoreValue(raw);\n\n    if (val === '') return null;\n\n    const n = Number(val);\n\n    return Number.isFinite(n) ? n : null;\n  }\n\n  function penaltyValue(raw) {\n    const val = scoreValue(raw);\n\n    if (val === '') return '';\n\n    return val;\n  }\n\n  function hasPens(m) {\n    return penaltyValue(m.aps) !== '' || penaltyValue(m.hps) !== '';\n  }\n\n  function teamName(team) {\n    if (!team) return '';\n    return team.displayName || team.shortDisplayName || team.name || team.abbreviation || '';\n  }\n\n  function teamShort(team) {\n    if (!team) return '';\n    return team.shortDisplayName || team.abbreviation || team.name || '';\n  }\n\n  function tzDateKey(dateLike, offsetDays = 0) {\n    const d = new Date(dateLike);\n\n    if (isNaN(d.getTime())) return '';\n\n    const shifted = new Date(d.getTime() + offsetDays * 24 * 60 * 60 * 1000);\n\n    try {\n      const parts = new Intl.DateTimeFormat('en-US', {\n        timeZone: MATCH_TZ,\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit'\n      }).formatToParts(shifted);\n\n      const y = parts.find(p => p.type === 'year')?.value;\n      const m = parts.find(p => p.type === 'month')?.value;\n      const day = parts.find(p => p.type === 'day')?.value;\n\n      return `${y}-${m}-${day}`;\n    } catch(e) {\n      return '';\n    }\n  }\n\n  function sameMatchDay(dateLike, offsetDays) {\n    const targetKey = tzDateKey(new Date(), offsetDays);\n    const matchKey = tzDateKey(dateLike, 0);\n\n    return targetKey && matchKey && targetKey === matchKey;\n  }\n\n  function fmtTime(iso) {\n    try {\n      return new Date(iso).toLocaleTimeString([], {\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    } catch(e) {\n      return esc(iso);\n    }\n  }\n\n  function fmtDateTime(iso) {\n    try {\n      return new Date(iso).toLocaleString([], {\n        weekday: 'short',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    } catch(e) {\n      return esc(iso);\n    }\n  }\n\n  function roundLabel(raw) {\n    const r = String(raw || '').toLowerCase();\n\n    if (!r) return '';\n\n    const map = {\n      'group-stage': 'Group Stage',\n      'round-of-32': 'Round of 32',\n      'round-of-16': 'Round of 16',\n      'quarterfinals': 'Quarterfinals',\n      'semi-finals': 'Semifinals',\n      'semifinals': 'Semifinals',\n      'third-place': 'Third Place',\n      'final': 'Final'\n    };\n\n    return map[r] || String(raw).replace(/-/g, ' ').replace(/\\b\\w/g, x => x.toUpperCase());\n  }\n\n  function contextLabel(m) {\n    const group = m.group || m.grp || m.g || '';\n\n    if (group) {\n      const g = String(group).replace(/^Group\\s*/i, '').trim().toUpperCase();\n      return `Group ${g}`;\n    }\n\n    if (m.rnd) return roundLabel(m.rnd);\n\n    return '';\n  }\n\n  function venueText(m) {\n    if (!m) return '';\n\n    if (m.v) return String(m.v);\n\n    const rawVenue = m.venue || m.location || {};\n\n    if (typeof rawVenue === 'string') return rawVenue;\n\n    if (rawVenue && typeof rawVenue === 'object') {\n      const address = rawVenue.address || {};\n\n      return [\n        rawVenue.fullName || rawVenue.name || rawVenue.displayName || rawVenue.shortName,\n        address.city || rawVenue.city || rawVenue.venueCity,\n        address.country || rawVenue.country || rawVenue.venueCountry\n      ].filter(x => x && String(x).trim()).join(', ');\n    }\n\n    return [\n      m.venueName,\n      m.venue_name,\n      m.stadium,\n      m.stadiumName,\n      m.city,\n      m.country\n    ].filter(x => x && String(x).trim()).join(', ');\n  }\n\n  function normalizeSchedule(m) {\n    return {\n      d: m.d || m.date || m.startDate,\n      a: m.a || m.away || m.awayTeam || '',\n      h: m.h || m.home || m.homeTeam || '',\n      an: m.an || m.awayName || m.aName || m.a || '',\n      hn: m.hn || m.homeName || m.hName || m.h || '',\n      asn: m.asn || m.awayShortName || m.a || '',\n      hsn: m.hsn || m.homeShortName || m.h || '',\n      af: m.af || m.awayFlag || m.awayLogo || '',\n      hf: m.hf || m.homeFlag || m.homeLogo || '',\n      as: scoreValue(m.as ?? m.awayScore),\n      hs: scoreValue(m.hs ?? m.homeScore),\n      aps: penaltyValue(m.aps ?? m.awayPenaltyScore ?? m.awayPenalties ?? m.awayShootoutScore),\n      hps: penaltyValue(m.hps ?? m.homePenaltyScore ?? m.homePenalties ?? m.homeShootoutScore),\n      s: m.s || m.state || m.status || 'pre',\n      det: m.det || m.detail || m.shortDetail || '',\n      rnd: m.rnd || m.round || m.stage || '',\n      group: m.group || m.grp || m.g || '',\n      v: venueText(m)\n    };\n  }\n\n  function normalizeScoreboard(e) {\n    const comp = e.competitions && e.competitions[0];\n    const cps = (comp && comp.competitors) || [];\n    const home = cps.find(x => x.homeAway === 'home') || {};\n    const away = cps.find(x => x.homeAway === 'away') || {};\n    const t = (e.status && e.status.type) || {};\n    const v = (comp && comp.venue) || {};\n    const ad = v.address || {};\n\n    return {\n      d: e.date,\n      a: away.team && away.team.abbreviation,\n      h: home.team && home.team.abbreviation,\n      an: teamName(away.team),\n      hn: teamName(home.team),\n      asn: teamShort(away.team),\n      hsn: teamShort(home.team),\n      af: away.team && away.team.logo,\n      hf: home.team && home.team.logo,\n      as: scoreValue(away.score),\n      hs: scoreValue(home.score),\n      aps: penaltyValue(away.penaltyScore ?? away.shootoutScore ?? away.penalties),\n      hps: penaltyValue(home.penaltyScore ?? home.shootoutScore ?? home.penalties),\n      s: t.state || 'pre',\n      det: t.shortDetail || '',\n      displayClock: e.status && e.status.displayClock,\n      period: e.status && e.status.period,\n      rnd: e.rnd || e.round || '',\n      group: e.group || e.grp || '',\n      v: [v.fullName, ad.city, ad.country].filter(Boolean).join(', ')\n    };\n  }\n\n  function teamKey(m) {\n    return [String(m.a || '').toUpperCase(), String(m.h || '').toUpperCase()].sort().join('|');\n  }\n\n  function matchKey(m) {\n    return `${tzDateKey(m.d, 0)}|${teamKey(m)}`;\n  }\n\n  function mergeWithScoreboard(scheduleMatch, scoreboardMap) {\n    const sbMatch = scoreboardMap.get(matchKey(scheduleMatch));\n\n    if (!sbMatch) return scheduleMatch;\n\n    return {\n      ...scheduleMatch,\n      ...sbMatch,\n      rnd: sbMatch.rnd || scheduleMatch.rnd,\n      group: sbMatch.group || scheduleMatch.group,\n      v: sbMatch.v || scheduleMatch.v\n    };\n  }\n\n  const normalizedSchedule = scheduleRaw.map(normalizeSchedule);\n  const scoreboardMatches = events.map(normalizeScoreboard);\n\n  const scoreboardMap = new Map();\n\n  scoreboardMatches.forEach(m => {\n    const key = matchKey(m);\n\n    if (key && !key.startsWith('|')) {\n      scoreboardMap.set(key, m);\n    }\n  });\n\n  let matches = [];\n\n  if (MODE === 'today') {\n    const todaySchedule = normalizedSchedule.filter(m => sameMatchDay(m.d, 0));\n\n    matches = todaySchedule.map(m => mergeWithScoreboard(m, scoreboardMap));\n\n    if (!matches.length) {\n      matches = scoreboardMatches.filter(m => sameMatchDay(m.d, 0));\n    }\n  } else if (MODE === 'yesterday') {\n    const yesterdaySchedule = normalizedSchedule.filter(m => sameMatchDay(m.d, -1));\n\n    matches = yesterdaySchedule.map(m => mergeWithScoreboard(m, scoreboardMap));\n  } else {\n    const now = new Date();\n    const todayKey = tzDateKey(now, 0);\n\n    matches = normalizedSchedule\n      .filter(m => {\n        const d = new Date(m.d);\n\n        if (isNaN(d.getTime())) return false;\n        if (d < now) return false;\n\n        const matchDayKey = tzDateKey(m.d, 0);\n\n        if (!SHOW_TODAY && matchDayKey === todayKey) return false;\n\n        return true;\n      })\n      .sort((x, y) => new Date(x.d) - new Date(y.d))\n      .slice(0, LIMIT)\n      .map(m => mergeWithScoreboard(m, scoreboardMap));\n  }\n\n  matches = matches.sort((x, y) => {\n    const xd = x.d || '';\n    const yd = y.d || '';\n    return xd < yd ? -1 : (xd > yd ? 1 : 0);\n  });\n\n  function resultInfo(m) {\n    if (m.s !== 'post') {\n      return {\n        result: 'none',\n        awayClass: '',\n        homeClass: '',\n        scoreClass: ''\n      };\n    }\n\n    const a = scoreNumber(m.as);\n    const h = scoreNumber(m.hs);\n    const ap = scoreNumber(m.aps);\n    const hp = scoreNumber(m.hps);\n\n    if (ap !== null && hp !== null && ap !== hp) {\n      return ap > hp\n        ? {\n            result: 'away-win',\n            awayClass: 'wc-score-team-win',\n            homeClass: 'wc-score-team-loss',\n            scoreClass: 'wc-score-main-finished'\n          }\n        : {\n            result: 'home-win',\n            awayClass: 'wc-score-team-loss',\n            homeClass: 'wc-score-team-win',\n            scoreClass: 'wc-score-main-finished'\n          };\n    }\n\n    if (a === null || h === null) {\n      return {\n        result: 'none',\n        awayClass: '',\n        homeClass: '',\n        scoreClass: ''\n      };\n    }\n\n    if (a === h) {\n      return {\n        result: 'draw',\n        awayClass: 'wc-score-team-draw',\n        homeClass: 'wc-score-team-draw',\n        scoreClass: 'wc-score-main-draw'\n      };\n    }\n\n    return a > h\n      ? {\n          result: 'away-win',\n          awayClass: 'wc-score-team-win',\n          homeClass: 'wc-score-team-loss',\n          scoreClass: 'wc-score-main-finished'\n        }\n      : {\n          result: 'home-win',\n          awayClass: 'wc-score-team-loss',\n          homeClass: 'wc-score-team-win',\n          scoreClass: 'wc-score-main-finished'\n        };\n  }\n\n  function statusBadge(m, result) {\n    if (m.s === 'in') return `<span class=\"wc-score-status wc-score-live\">LIVE</span>`;\n    if (m.s === 'post' && hasPens(m)) return `<span class=\"wc-score-status wc-score-finished\">PENS</span>`;\n    if (m.s === 'post' && result === 'draw') return `<span class=\"wc-score-status wc-score-draw\">DRAW</span>`;\n    if (m.s === 'post') return `<span class=\"wc-score-status wc-score-finished\">FINISHED</span>`;\n    return `<span class=\"wc-score-status wc-score-scheduled\">SCHEDULED</span>`;\n  }\n\n  function detailText(m) {\n    if (m.s === 'pre') {\n      return MODE === 'upcoming' ? fmtDateTime(m.d) : fmtTime(m.d);\n    }\n\n    if (m.s === 'post') {\n      if (hasPens(m)) return 'Pens';\n      if (String(m.det || '').toUpperCase().includes('AET')) return 'AET';\n      return m.det || 'FT';\n    }\n\n    return m.displayClock || m.det || 'Live';\n  }\n\n  function scoreHtml(m) {\n    const awayScore = scoreValue(m.as);\n    const homeScore = scoreValue(m.hs);\n\n    if (m.s === 'pre' && awayScore === '' && homeScore === '') {\n      return 'vs';\n    }\n\n    const main = `${esc(awayScore || '0')}–${esc(homeScore || '0')}`;\n\n    if (!hasPens(m)) return main;\n\n    return `\n      <div class=\"wc-score-main-stack\">\n        <div>${main}</div>\n        <div class=\"wc-score-pens\">${esc(m.aps || '0')}–${esc(m.hps || '0')} pens</div>\n      </div>\n    `;\n  }\n\n  function displayNames(m) {\n    const awayFull = m.an || m.a || 'TBD';\n    const homeFull = m.hn || m.h || 'TBD';\n    const awayShort = m.asn || m.a || awayFull;\n    const homeShort = m.hsn || m.h || homeFull;\n\n    const useShort = String(awayFull).length + String(homeFull).length > 31;\n\n    return {\n      away: useShort ? awayShort : awayFull,\n      home: useShort ? homeShort : homeFull\n    };\n  }\n\n  const cards = matches.map(m => {\n    const live = m.s === 'in';\n    const result = resultInfo(m);\n    const venue = venueText(m);\n    const context = contextLabel(m);\n    const names = displayNames(m);\n\n    const venueLine = venue\n      ? `<div class=\"wc-score-venue\">${locationIcon}<span>${esc(venue)}</span></div>`\n      : '';\n\n    const contextLine = context\n      ? `<span class=\"wc-score-context\">${esc(context)}</span>`\n      : '';\n\n    return `\n      <div class=\"wc-score-card ${live ? 'wc-score-card-live' : ''}\">\n        <div class=\"wc-score-top\">\n          <div class=\"wc-score-top-left\">\n            ${statusBadge(m, result.result)}\n            ${contextLine}\n          </div>\n\n          <span class=\"wc-score-detail\">${detailText(m)}</span>\n        </div>\n\n        <div class=\"wc-score-teams\">\n          <div class=\"wc-score-team wc-score-team-away ${result.awayClass}\">\n            ${flag(m.af)}\n            <span>${esc(names.away)}</span>\n          </div>\n\n          <div class=\"wc-score-main ${result.scoreClass}\">\n            ${scoreHtml(m)}\n          </div>\n\n          <div class=\"wc-score-team wc-score-team-home ${result.homeClass}\">\n            <span>${esc(names.home)}</span>\n            ${flag(m.hf)}\n          </div>\n        </div>\n\n        ${venueLine}\n      </div>\n    `;\n  }).join('');\n\n  const emptyText = MODE === 'yesterday'\n    ? 'No matches yesterday'\n    : MODE === 'upcoming'\n      ? 'No upcoming matches'\n      : 'No matches today';\n\n  const body = cards || `\n    <div class=\"wc-score-empty\">\n      <div class=\"wc-score-empty-title\">${emptyText}</div>\n      <div class=\"wc-score-empty-sub\">Matches will appear here when available.</div>\n    </div>\n  `;\n\n  return `\n    <style>\n      @keyframes wcScoreLivePulse {\n        0% {\n          box-shadow: 0 0 8px rgba(239,68,68,.12);\n        }\n\n        50% {\n          box-shadow: 0 0 16px rgba(239,68,68,.28);\n        }\n\n        100% {\n          box-shadow: 0 0 8px rgba(239,68,68,.12);\n        }\n      }\n\n      .wc-score-section {\n        width: 100%;\n        max-width: 100%;\n        min-width: 0;\n        box-sizing: border-box;\n        overflow: hidden;\n        position: static;\n        left: auto;\n        transform: none;\n      }\n\n    .wc-score-wrap {\n        width: 100%;\n        max-width: 100%;\n        min-width: 0;\n        margin: 0;\n        box-sizing: border-box;\n        display: flex;\n        flex-wrap: wrap;\n        gap: 10px;\n        align-items: stretch;\n        justify-content: flex-start;\n        overflow: hidden;\n      }\n\n      .wc-score-card {\n        flex: 0 0 ${CARD_WIDTH}px;\n        width: ${CARD_WIDTH}px;\n        min-width: 0;\n        max-width: ${CARD_WIDTH}px;\n        background: rgba(24,26,36,.70);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 15px;\n        padding: 10px;\n        box-sizing: border-box;\n        overflow: hidden;\n      }\n\n      .wc-score-card-live {\n        border-color: rgba(239,68,68,.50);\n        animation: wcScoreLivePulse 2s ease-in-out infinite;\n      }\n\n      .wc-score-top {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 10px;\n        margin-bottom: 8px;\n        min-width: 0;\n      }\n\n      .wc-score-top-left {\n        display: flex;\n        align-items: center;\n        gap: 5px;\n        min-width: 0;\n        overflow: hidden;\n      }\n\n      .wc-score-status,\n      .wc-score-context {\n        border-radius: 999px;\n        padding: 3px 8px;\n        font-size: 11px;\n        font-weight: 850;\n        letter-spacing: .2px;\n        white-space: nowrap;\n        flex: 0 0 auto;\n      }\n\n      .wc-score-context {\n        background: rgba(255,255,255,.07);\n        color: #cbd5e1;\n        border: 1px solid rgba(255,255,255,.10);\n        max-width: 120px;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-score-live {\n        background: rgba(239,68,68,.16);\n        color: #fca5a5;\n        border: 1px solid rgba(239,68,68,.36);\n      }\n\n      .wc-score-finished {\n        background: rgba(34,197,94,.12);\n        color: #86efac;\n        border: 1px solid rgba(34,197,94,.22);\n      }\n\n      .wc-score-draw {\n        background: rgba(245,158,11,.12);\n        color: #fde68a;\n        border: 1px solid rgba(245,158,11,.24);\n      }\n\n      .wc-score-scheduled {\n        background: rgba(148,163,184,.10);\n        color: #cbd5e1;\n        border: 1px solid rgba(148,163,184,.16);\n      }\n\n      .wc-score-detail {\n        color: #94a3b8;\n        font-size: 12px;\n        font-weight: 750;\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        white-space: nowrap;\n        text-align: right;\n      }\n\n      .wc-score-teams {\n        display: grid;\n        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n        align-items: center;\n        gap: 8px;\n        background: rgba(17,19,33,.52);\n        border: 1px solid rgba(255,255,255,.06);\n        border-radius: 11px;\n        padding: 8px;\n        min-width: 0;\n        box-sizing: border-box;\n      }\n\n      .wc-score-team {\n        display: flex;\n        align-items: center;\n        gap: 7px;\n        min-width: 0;\n        color: #f8fafc;\n        font-size: 14px;\n        font-weight: 850;\n        font-style: italic;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        border-radius: 9px;\n        padding: 5px 7px;\n        box-sizing: border-box;\n        border: 1px solid transparent;\n        transition:\n          background .2s ease,\n          border-color .2s ease,\n          color .2s ease,\n          opacity .2s ease,\n          filter .2s ease;\n      }\n\n      .wc-score-team span {\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-score-team-away {\n        justify-content: flex-start;\n      }\n\n      .wc-score-team-home {\n        justify-content: flex-end;\n        text-align: right;\n      }\n\n      .wc-score-team-win {\n        color: #bbf7d0;\n        background: rgba(34,197,94,.14);\n        border-color: rgba(34,197,94,.28);\n        box-shadow: inset 0 0 12px rgba(34,197,94,.08);\n      }\n\n      .wc-score-team-loss {\n        color: #fecaca;\n        background: rgba(127,29,29,.16);\n        border-color: rgba(239,68,68,.18);\n        opacity: .68;\n        filter: saturate(.78) brightness(.88);\n      }\n\n      .wc-score-team-draw {\n        color: #fde68a;\n        background: rgba(245,158,11,.11);\n        border-color: rgba(245,158,11,.23);\n      }\n\n      .wc-score-main {\n        color: #e2e8f0;\n        font-size: 15px;\n        font-weight: 900;\n        white-space: nowrap;\n        text-align: center;\n        min-width: 42px;\n      }\n\n      .wc-score-main-finished {\n        color: #f8fafc;\n      }\n\n      .wc-score-main-draw {\n        color: #fde68a;\n      }\n\n      .wc-score-main-stack {\n        line-height: 1.05;\n      }\n\n      .wc-score-pens {\n        color: #cbd5e1;\n        font-size: 9px;\n        font-weight: 850;\n        margin-top: 2px;\n        opacity: .92;\n      }\n\n      .wc-score-venue {\n        display: flex;\n        align-items: center;\n        gap: 5px;\n        color: #94a3b8;\n        font-size: 12px;\n        margin-top: 8px;\n        min-width: 0;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-score-venue span {\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-score-icon {\n        width: 13px;\n        height: 13px;\n        fill: currentColor;\n        flex: 0 0 auto;\n        opacity: .78;\n      }\n\n      .wc-score-flag {\n        height: 22px;\n        width: auto;\n        vertical-align: middle;\n        border-radius: 3px;\n        flex: 0 0 auto;\n      }\n\n      .wc-score-empty {\n        color: #94a3b8;\n        width: 100%;\n        min-width: 0;\n        padding: 12px;\n        box-sizing: border-box;\n        background: rgba(24,26,36,.50);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 14px;\n      }\n\n      .wc-score-empty-title {\n        color: #cbd5e1;\n        font-size: 13px;\n        font-weight: 800;\n      }\n\n      .wc-score-empty-sub {\n        color: #94a3b8;\n        font-size: 11px;\n        margin-top: 2px;\n      }\n\n      @media (max-width: ${CARD_WIDTH + 20}px) {\n        .wc-score-wrap {\n          justify-content: stretch;\n        }\n      \n        .wc-score-card {\n          flex: 1 1 100%;\n          width: 100%;\n          max-width: 100%;\n          padding: 9px;\n        }\n      \n        .wc-score-teams {\n          gap: 7px;\n          padding: 7px;\n        }\n      \n        .wc-score-team {\n          gap: 6px;\n          font-size: 13px;\n          padding: 5px 6px;\n        }\n      \n        .wc-score-flag {\n          height: 20px;\n        }\n      \n        .wc-score-main {\n          font-size: 14px;\n          min-width: 36px;\n        }\n      \n        .wc-score-detail,\n        .wc-score-venue {\n          font-size: 11px;\n        }\n      \n        .wc-score-icon {\n          width: 12px;\n          height: 12px;\n        }\n      } \n    </style>\n\n    <div class=\"wc-score-section\">\n      <div class=\"wc-score-wrap\">\n        ${body}\n      </div>\n    </div>\n  `;\n]]]"
          },
          "styles": {
            "card": [
              {
                "display": "[[[\n  const hide = variables.hide_if_empty === true || variables.hide_if_empty === 'true';\n  if (!hide) return 'block';\n\n  const sch = states['sensor.world_cup_schedule'];\n  const matches = (sch && sch.attributes && sch.attributes.matches) || [];\n  const mode = String(variables.mode || 'today').toLowerCase();\n\n  const MATCH_TZ = String(variables.match_timezone || 'America/New_York');\n  const SHOW_TODAY = variables.show_today === true || variables.show_today === 'true';\n\n  function tzDateKey(dateLike, offsetDays = 0) {\n    const d = new Date(dateLike);\n\n    if (isNaN(d.getTime())) return '';\n\n    const shifted = new Date(d.getTime() + offsetDays * 24 * 60 * 60 * 1000);\n\n    try {\n      const parts = new Intl.DateTimeFormat('en-US', {\n        timeZone: MATCH_TZ,\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit'\n      }).formatToParts(shifted);\n\n      const y = parts.find(p => p.type === 'year')?.value;\n      const m = parts.find(p => p.type === 'month')?.value;\n      const day = parts.find(p => p.type === 'day')?.value;\n\n      return `${y}-${m}-${day}`;\n    } catch(e) {\n      return '';\n    }\n  }\n\n  function sameMatchDay(dateLike, offsetDays) {\n    const targetKey = tzDateKey(new Date(), offsetDays);\n    const matchKey = tzDateKey(dateLike, 0);\n\n    return targetKey && matchKey && targetKey === matchKey;\n  }\n\n  const now = new Date();\n  const todayKey = tzDateKey(now, 0);\n\n  let found = false;\n\n  if (mode === 'yesterday') {\n    found = matches.some(m => sameMatchDay(m.d || m.date || m.startDate, -1));\n  } else if (mode === 'upcoming') {\n    found = matches.some(m => {\n      const dateRaw = m.d || m.date || m.startDate;\n      const d = new Date(dateRaw);\n\n      if (isNaN(d.getTime())) return false;\n      if (d < now) return false;\n\n      const matchKey = tzDateKey(dateRaw, 0);\n\n      if (!SHOW_TODAY && matchKey === todayKey) return false;\n\n      return true;\n    });\n  } else {\n    found = matches.some(m => sameMatchDay(m.d || m.date || m.startDate, 0));\n  }\n\n  return found ? 'block' : 'none';\n]]]"
              },
