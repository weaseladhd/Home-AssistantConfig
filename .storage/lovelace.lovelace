                                      "show_header_toggle": false,
                                      "type": "entities"
                                    }
                                  ]
                                },
                                {
                                  "type": "custom:hui-element",
                                  "card_type": "markdown",
                                  "content": "{% if states('sensor.current_version') | regex_search('b') %} <span><ha-icon icon=\"mdi:home-assistant\"></ha-icon> Home Assistant {{ states('sensor.current_version') }}</span><br> {% if states('sensor.current_version') == states('sensor.home_assistant_versions_beta') %} <b>No updates - {{ state_attr('sensor.home_assistant_versions_dev', 'friendly_name') }} {{ states('sensor.home_assistant_versions_dev') | lower }}</b> {% else %} <b>{{ states('sensor.home_assistant_versions_beta') }} available</b> {{ '\\U0001f389' }}\n{% if states('sensor.home_assistant_versions_beta') == states('sensor.hass_release_notes_rc') %} {{- state_attr('sensor.hass_release_notes_rc', 'body') }} {% endif %} {% endif %} {% else %} <span><ha-icon icon=\"mdi:home-assistant\"></ha-icon> Home Assistant {{ states('sensor.current_version') }}</span><br> {% if states('sensor.current_version') == states('sensor.home_assistant_versions') %} <b>No updates - {{ state_attr('sensor.home_assistant_versions_dev', 'friendly_name') }} {{ states('sensor.home_assistant_versions_dev') | lower }}</b> {% else %} <b>{{ states('sensor.home_assistant_versions') }} available</b> {{ '\\U0001f389' }}\n{% if states('sensor.home_assistant_versions') == states('sensor.hass_release_notes') %} {{- state_attr('sensor.hass_release_notes', 'body') }} {% endif %} {% endif %} {% endif %}\n"
                                },
                                {
                                  "card": {
                                    "type": "entities",
                                    "state_color": true
                                  },
                                  "filter": {
                                    "include": [
