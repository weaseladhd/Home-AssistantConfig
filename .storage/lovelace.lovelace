                      "type": "column",
                      "color": "#7f7f7f",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Cipres\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Cipres\").value]));\n"
                    }
                  ],
                  "apex_config": {
