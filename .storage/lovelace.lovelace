        },
        {
          "type": "sections",
          "max_columns": 4,
          "title": "World-Cup",
          "path": "world-cup",
          "icon": "mdi:soccer",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "entity": "sensor.world_cup_scoreboard",
                  "triggers_update": [
                    "sensor.world_cup_scoreboard"
                  ],
                  "show_icon": false,
                  "show_name": false,
                  "show_state": false,
                  "show_label": false,
                  "variables": {
                    "team_abbr": "NED",
                    "team_name": "Netherlands"
                  },
                  "tap_action": {
                    "action": "none"
                  },
                  "custom_fields": {
                    "content": "[[[\n  const sb = states['sensor.world_cup_scoreboard'];\n  const events = (sb && sb.attributes && sb.attributes.events) || [];\n\n  const TEAM_ABBR = String(variables.team_abbr || 'NED').toUpperCase();\n  const TEAM_NAME = String(variables.team_name || 'Netherlands');\n\n  const esc = s => (s == null ? '' : String(s));\n\n  const teamName = team => {\n    if (!team) return '';\n    return team.displayName || team.shortDisplayName || team.name || team.abbreviation || '';\n  };\n\n  const teamAbbr = team => {\n    if (!team) return '';\n    return team.abbreviation || team.shortDisplayName || team.name || '';\n  };\n\n  const logo = team => {\n    if (!team) return '';\n    return team.logo || (team.logos && team.logos[0] && team.logos[0].href) || '';\n  };\n\n  const venueStr = comp => {\n    const v = (comp && comp.venue) || {};\n    const a = v.address || {};\n\n    return [\n      v.fullName,\n      a.city,\n      a.country\n    ].filter(x => x && String(x).trim()).join(', ');\n  };\n\n  const fmtDateTime = iso => {\n    try {\n      return new Date(iso).toLocaleString([], {\n        weekday: 'short',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    } catch(e) {\n      return esc(iso);\n    }\n  };\n\n  const getScore = competitor => {\n    if (!competitor) return '';\n\n    const raw = competitor.score;\n\n    if (raw == null || raw === '') return '';\n\n    if (typeof raw === 'object') {\n      return raw.displayValue ?? raw.value ?? raw.score ?? '';\n    }\n\n    return raw;\n  };\n\n  const getNumericScore = competitor => {\n    const score = getScore(competitor);\n    const n = parseInt(score, 10);\n    return isNaN(n) ? null : n;\n  };\n\n  const isTargetTeam = competitor => {\n    const t = competitor && competitor.team;\n    if (!t) return false;\n\n    const abbr = String(t.abbreviation || '').toUpperCase();\n    const name = String(t.displayName || t.shortDisplayName || t.name || '').toLowerCase();\n\n    return abbr === TEAM_ABBR || name === TEAM_NAME.toLowerCase();\n  };\n\n  let team = null;\n  let opponent = null;\n  let statusType = null;\n  let match = null;\n  let comp = null;\n\n  for (const e of events) {\n    const c = e.competitions && e.competitions[0];\n    const competitors = (c && c.competitors) || [];\n\n    const found = competitors.find(isTargetTeam);\n\n    if (found) {\n      team = found;\n      opponent = competitors.find(x => x !== found) || null;\n      statusType = (e.status && e.status.type) || {};\n      match = e;\n      comp = c;\n      break;\n    }\n  }\n\n  if (!team || !opponent || !match || !comp) {\n    return '';\n  }\n\n  const state = statusType.state || 'pre';\n  const live = state === 'in';\n  const finished = state === 'post';\n  const scheduled = state === 'pre';\n\n  const teamScore = getScore(team);\n  const opponentScore = getScore(opponent);\n\n  const scoreText = scheduled && teamScore === '' && opponentScore === ''\n    ? 'vs'\n    : `${esc(teamScore || '0')} – ${esc(opponentScore || '0')}`;\n\n  const currentScore = getNumericScore(team);\n  const scoreKey = `__wcScore_${TEAM_ABBR}`;\n  const flashKey = `__wcFlashUntil_${TEAM_ABBR}`;\n\n  if (currentScore !== null) {\n    const previousScore = window[scoreKey];\n\n    if (typeof previousScore === 'number' && currentScore > previousScore) {\n      window[flashKey] = Date.now() + 10000;\n    }\n\n    window[scoreKey] = currentScore;\n  }\n\n  const flash = !!(window[flashKey] && Date.now() < window[flashKey]);\n\n  const badgeClass = live\n    ? 'wc-ned-live'\n    : finished\n      ? 'wc-ned-finished'\n      : 'wc-ned-scheduled';\n\n  const badgeText = live\n    ? 'LIVE'\n    : finished\n      ? 'FINISHED'\n      : 'SCHEDULED';\n\n  const detailText = () => {\n    if (scheduled) return fmtDateTime(match.date);\n    if (finished) return statusType.shortDetail || 'FT';\n    return statusType.shortDetail || 'Live';\n  };\n\n  const liveTicker = () => {\n    if (!live) return '';\n\n    const s = match.status || {};\n    const shortDetail = String(statusType.shortDetail || '').toUpperCase();\n    const description = String(statusType.description || '').toLowerCase();\n\n    if (shortDetail === 'HT' || description.includes('halftime')) {\n      return '⏸ Halftime';\n    }\n\n    const displayClock = s.displayClock || statusType.shortDetail || '';\n    const period = Number(s.period || 0);\n\n    let half = 'In play';\n\n    if (period === 1) half = '1st half';\n    if (period >= 2) half = '2nd half';\n\n    let timeLeft = '';\n\n    if (typeof s.clock === 'number' && period > 0) {\n      const mins = Math.floor(s.clock / 60);\n      const endAt = period === 1 ? 45 : 90;\n      const rem = endAt - mins;\n\n      timeLeft = rem > 0\n        ? ` · ~${rem} min left${period === 1 ? ' in half' : ''}`\n        : ' · stoppage time';\n    }\n\n    return `⏱ ${half}${displayClock ? ' · ' + esc(displayClock) : ''}${timeLeft}`;\n  };\n\n  const ticker = liveTicker();\n  const venue = venueStr(comp);\n\n  const teamLogo = logo(team.team);\n  const opponentLogo = logo(opponent.team);\n\n  const teamFullName = teamName(team.team) || TEAM_NAME;\n  const opponentFullName = teamName(opponent.team) || teamAbbr(opponent.team);\n\n  const teamShort = teamAbbr(team.team) || TEAM_ABBR;\n  const opponentShort = teamAbbr(opponent.team);\n\n  return `\n    <style>\n      .wc-ned-wrap {\n        width: 100%;\n        max-width: 100%;\n        min-width: 0;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        box-sizing: border-box;\n      }\n\n      .wc-ned-card {\n        width: 100%;\n        max-width: 920px;\n        min-width: 0;\n        border-radius: 18px;\n        padding: 18px;\n        display: grid;\n        grid-template-columns: 140px minmax(0, 1fr) 140px;\n        align-items: center;\n        gap: 22px;\n        border: 1px solid rgba(255,255,255,.14);\n        box-sizing: border-box;\n        background: linear-gradient(120deg, rgba(249,115,22,.92), rgba(234,88,12,.92));\n        box-shadow: 0 0 22px rgba(249,115,22,.32);\n        overflow: hidden;\n        ${flash ? 'animation: wcNedGoal 1s ease-in-out 10;' : ''}\n      }\n\n      .wc-ned-team {\n        text-align: center;\n        min-width: 0;\n      }\n\n      .wc-ned-logo {\n        height: 88px;\n        max-width: 105px;\n        object-fit: contain;\n      }\n\n      .wc-ned-team-name {\n        color: #fff;\n        font-weight: 800;\n        font-size: 13px;\n        margin-top: 6px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-ned-center {\n        text-align: center;\n        color: #fff;\n        min-width: 0;\n      }\n\n      .wc-ned-goal {\n        font-size: 13px;\n        font-weight: 900;\n        letter-spacing: 1px;\n        color: #bbf7d0;\n        margin-bottom: 6px;\n      }\n\n      .wc-ned-score {\n        font-size: 48px;\n        font-weight: 900;\n        line-height: 1;\n        white-space: nowrap;\n      }\n\n      .wc-ned-badge-row {\n        margin-top: 9px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        gap: 8px;\n        flex-wrap: wrap;\n      }\n\n      .wc-ned-badge {\n        border-radius: 999px;\n        padding: 4px 10px;\n        font-size: 11px;\n        font-weight: 900;\n        letter-spacing: .3px;\n        white-space: nowrap;\n      }\n\n      .wc-ned-live {\n        color: #fff;\n        background: rgba(239,68,68,.30);\n        border: 1px solid rgba(255,255,255,.30);\n        box-shadow: 0 0 12px rgba(239,68,68,.35);\n      }\n\n      .wc-ned-finished {\n        color: #dcfce7;\n        background: rgba(34,197,94,.18);\n        border: 1px solid rgba(220,252,231,.26);\n      }\n\n      .wc-ned-scheduled {\n        color: #fff7ed;\n        background: rgba(255,255,255,.14);\n        border: 1px solid rgba(255,255,255,.22);\n      }\n\n      .wc-ned-detail {\n        font-size: 13px;\n        font-weight: 750;\n        opacity: .96;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        max-width: 100%;\n      }\n\n      .wc-ned-ticker {\n        margin-top: 8px;\n        display: inline-block;\n        background: rgba(255,255,255,.14);\n        border: 1px solid rgba(255,255,255,.24);\n        border-radius: 999px;\n        padding: 4px 12px;\n        font-size: 13px;\n        font-weight: 800;\n        color: #fff;\n        max-width: 100%;\n        box-sizing: border-box;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-ned-match-title {\n        font-size: 12px;\n        opacity: .80;\n        margin-top: 8px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-ned-meta {\n        font-size: 12px;\n        opacity: .88;\n        margin-top: 4px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      @media (max-width: 720px) {\n        .wc-ned-card {\n          grid-template-columns: 90px minmax(0, 1fr) 90px;\n          gap: 12px;\n          padding: 14px;\n          border-radius: 16px;\n        }\n\n        .wc-ned-logo {\n          height: 62px;\n          max-width: 78px;\n        }\n\n        .wc-ned-team-name {\n          font-size: 11px;\n        }\n\n        .wc-ned-score {\n          font-size: 36px;\n        }\n\n        .wc-ned-detail,\n        .wc-ned-ticker,\n        .wc-ned-match-title,\n        .wc-ned-meta {\n          font-size: 11px;\n        }\n      }\n\n      @media (max-width: 460px) {\n        .wc-ned-card {\n          grid-template-columns: 1fr;\n          gap: 10px;\n          padding: 13px;\n        }\n\n        .wc-ned-team {\n          display: flex;\n          align-items: center;\n          justify-content: center;\n          gap: 8px;\n        }\n\n        .wc-ned-logo {\n          height: 42px;\n          max-width: 58px;\n        }\n\n        .wc-ned-team-name {\n          margin-top: 0;\n          font-size: 12px;\n          max-width: 170px;\n        }\n\n        .wc-ned-center {\n          order: -1;\n        }\n\n        .wc-ned-score {\n          font-size: 34px;\n        }\n\n        .wc-ned-badge-row {\n          gap: 6px;\n        }\n\n        .wc-ned-badge {\n          font-size: 10px;\n          padding: 3px 8px;\n        }\n      }\n    </style>\n\n    <div class=\"wc-ned-wrap\">\n      <div class=\"wc-ned-card\">\n        <div class=\"wc-ned-team\">\n          ${teamLogo ? `<img src=\"${teamLogo}\" class=\"wc-ned-logo\">` : ''}\n          <div class=\"wc-ned-team-name\">${esc(teamFullName || teamShort)}</div>\n        </div>\n\n        <div class=\"wc-ned-center\">\n          ${flash ? `<div class=\"wc-ned-goal\">⚽ GOAL! ${esc(TEAM_NAME.toUpperCase())}! ⚽</div>` : ''}\n\n          <div class=\"wc-ned-score\">${scoreText}</div>\n\n          <div class=\"wc-ned-badge-row\">\n            <span class=\"wc-ned-badge ${badgeClass}\">${badgeText}</span>\n            <span class=\"wc-ned-detail\">${esc(detailText())}</span>\n          </div>\n\n          ${ticker ? `<div class=\"wc-ned-ticker\">${ticker}</div>` : ''}\n\n          <div class=\"wc-ned-match-title\">${esc(teamFullName)} vs ${esc(opponentFullName)}</div>\n          <div class=\"wc-ned-meta\">🕒 ${fmtDateTime(match.date)}${venue ? ` · 📍 ${esc(venue)}` : ''}</div>\n        </div>\n\n        <div class=\"wc-ned-team\">\n          ${opponentLogo ? `<img src=\"${opponentLogo}\" class=\"wc-ned-logo\">` : ''}\n          <div class=\"wc-ned-team-name\">${esc(opponentFullName || opponentShort)}</div>\n        </div>\n      </div>\n    </div>\n  `;\n]]]"
                  },
                  "styles": {
                    "card": [
                      {
                        "display": "[[[\n  const sb = states['sensor.world_cup_scoreboard'];\n  const events = (sb && sb.attributes && sb.attributes.events) || [];\n\n  const TEAM_ABBR = String(variables.team_abbr || 'NED').toUpperCase();\n  const TEAM_NAME = String(variables.team_name || 'Netherlands').toLowerCase();\n\n  const found = events.some(e => {\n    const c = e.competitions && e.competitions[0];\n    const competitors = (c && c.competitors) || [];\n\n    return competitors.some(comp => {\n      const t = comp && comp.team;\n      if (!t) return false;\n\n      const abbr = String(t.abbreviation || '').toUpperCase();\n      const name = String(t.displayName || t.shortDisplayName || t.name || '').toLowerCase();\n\n      return abbr === TEAM_ABBR || name === TEAM_NAME;\n    });\n  });\n\n  return found ? 'block' : 'none';\n]]]"
                      },
                      {
                        "background": "transparent"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "border": "none"
                      },
                      {
                        "padding": 0
                      },
                      {
                        "width": "100%"
                      },
                      {
                        "max-width": "100%"
                      },
                      {
                        "min-width": 0
                      },
                      {
                        "overflow": "visible"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "\"content\""
                      },
                      {
                        "grid-template-columns": "1fr"
                      },
                      {
                        "justify-items": "stretch"
                      },
                      {
                        "align-items": "stretch"
                      },
                      {
                        "min-width": 0
                      }
                    ],
                    "custom_fields": {
                      "content": [
                        {
                          "justify-self": "stretch"
                        },
                        {
                          "width": "100%"
                        },
                        {
                          "max-width": "100%"
                        },
                        {
                          "min-width": 0
                        },
                        {
                          "display": "block"
                        },
                        {
                          "overflow": "visible"
                        }
                      ]
                    }
                  },
                  "grid_options": {
                    "columns": "full"
                  },
                  "extra_styles": "@keyframes wcNedGoal {\n  0% {\n    background: linear-gradient(120deg,#16a34a,#22c55e);\n    box-shadow: 0 0 42px rgba(34,197,94,.75);\n  }\n\n  50% {\n    background: linear-gradient(120deg,#f97316,#ea580c);\n    box-shadow: 0 0 14px rgba(249,115,22,.35);\n  }\n\n  100% {\n    background: linear-gradient(120deg,#16a34a,#22c55e);\n    box-shadow: 0 0 42px rgba(34,197,94,.75);\n  }\n}\n"
                },
                {
                  "type": "custom:button-card",
                  "entity": "sensor.world_cup_scoreboard",
                  "triggers_update": [
                    "sensor.world_cup_scoreboard",
                    "sensor.world_cup_schedule",
                    "sensor.world_cup_standings"
                  ],
                  "show_icon": false,
                  "show_name": false,
                  "show_state": false,
                  "show_label": false,
                  "variables": {
                    "team_abbr": "NED",
                    "team_name": "Netherlands",
                    "card_max_width": 2000,
                    "align": "center"
                  },
                  "tap_action": {
                    "action": "none"
                  },
                  "custom_fields": {
                    "content": "[[[\n  const sb = states['sensor.world_cup_scoreboard'];\n  const sch = states['sensor.world_cup_schedule'];\n  const st = states['sensor.world_cup_standings'];\n\n  const events = (sb && sb.attributes && sb.attributes.events) || [];\n  const scheduleMatches = (sch && sch.attributes && sch.attributes.matches) || [];\n  const groups = (st && st.attributes && st.attributes.children) || [];\n\n  const TEAM_ABBR = String(variables.team_abbr || 'NED').toUpperCase();\n  const TEAM_NAME = String(variables.team_name || 'Netherlands');\n\n  const CARD_MAX_WIDTH = Math.max(320, Number(variables.card_max_width || 2000));\n  const ALIGN = String(variables.align || 'center').toLowerCase();\n\n  const justify = ALIGN === 'left' || ALIGN === 'start'\n    ? 'flex-start'\n    : ALIGN === 'right' || ALIGN === 'end'\n      ? 'flex-end'\n      : 'center';\n\n  const esc = s => (s == null ? '' : String(s));\n\n  const calendarIcon = `\n    <svg class=\"wc-ned-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1.5A2.5 2.5 0 0 1 22 6.5v12A2.5 2.5 0 0 1 19.5 21h-15A2.5 2.5 0 0 1 2 18.5v-12A2.5 2.5 0 0 1 4.5 4H6V3a1 1 0 0 1 1-1Zm12.5 8h-15v8.5a.5.5 0 0 0 .5.5h14a.5.5 0 0 0 .5-.5V10ZM5 6a.5.5 0 0 0-.5.5V8h15V6.5A.5.5 0 0 0 19 6H5Z\"/>\n    </svg>\n  `;\n\n  const locationIcon = `\n    <svg class=\"wc-ned-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z\"/>\n    </svg>\n  `;\n\n  function scoreValue(raw) {\n    if (raw == null || raw === '') return '';\n\n    if (typeof raw === 'object') {\n      return raw.displayValue ?? raw.value ?? raw.score ?? '';\n    }\n\n    return raw;\n  }\n\n  function teamName(team) {\n    if (!team) return '';\n    return team.displayName || team.shortDisplayName || team.name || team.abbreviation || '';\n  }\n\n  function teamAbbr(team) {\n    if (!team) return '';\n    return team.abbreviation || team.shortDisplayName || team.name || '';\n  }\n\n  function logo(team) {\n    if (!team) return '';\n    return team.logo || (team.logos && team.logos[0] && team.logos[0].href) || '';\n  }\n\n  function isTargetTeamFromTeam(team) {\n    if (!team) return false;\n\n    const abbr = String(team.abbreviation || '').toUpperCase();\n    const name = String(team.displayName || team.shortDisplayName || team.name || '').toLowerCase();\n\n    return abbr === TEAM_ABBR || name === TEAM_NAME.toLowerCase();\n  }\n\n  function isTargetAbbr(abbr, name) {\n    return String(abbr || '').toUpperCase() === TEAM_ABBR ||\n      String(name || '').toLowerCase() === TEAM_NAME.toLowerCase();\n  }\n\n  function fmtDateTime(iso) {\n    try {\n      return new Date(iso).toLocaleString([], {\n        weekday: 'short',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    } catch(e) {\n      return esc(iso);\n    }\n  }\n\n  function roundLabel(raw) {\n    const r = String(raw || '').toLowerCase();\n\n    if (!r) return '';\n\n    const map = {\n      'group-stage': 'Group Stage',\n      'round-of-32': 'Round of 32',\n      'round-of-16': 'Round of 16',\n      'quarterfinals': 'Quarterfinals',\n      'semi-finals': 'Semifinals',\n      'semifinals': 'Semifinals',\n      'third-place': 'Third Place',\n      'final': 'Final'\n    };\n\n    return map[r] || String(raw).replace(/-/g, ' ').replace(/\\b\\w/g, x => x.toUpperCase());\n  }\n\n  function groupLabel(raw) {\n    if (!raw) return '';\n\n    const g = String(raw).replace(/^Group\\s*/i, '').trim().toUpperCase();\n\n    return g ? `Group ${g}` : '';\n  }\n\n  function matchContext(selected) {\n    if (!selected) return '';\n\n    if (selected.group) return groupLabel(selected.group);\n    if (selected.rnd) return roundLabel(selected.rnd);\n\n    return '';\n  }\n\n  function venueTextFromComp(comp) {\n    const v = (comp && comp.venue) || {};\n    const a = v.address || {};\n\n    return [\n      v.fullName,\n      a.city,\n      a.country\n    ].filter(x => x && String(x).trim()).join(', ');\n  }\n\n  function venueTextFromMatch(m) {\n    if (!m) return '';\n\n    if (m.v) return String(m.v);\n\n    const rawVenue = m.venue || m.location || {};\n\n    if (typeof rawVenue === 'string') return rawVenue;\n\n    if (rawVenue && typeof rawVenue === 'object') {\n      const address = rawVenue.address || {};\n\n      return [\n        rawVenue.fullName || rawVenue.name || rawVenue.displayName || rawVenue.shortName,\n        address.city || rawVenue.city || rawVenue.venueCity,\n        address.country || rawVenue.country || rawVenue.venueCountry\n      ].filter(x => x && String(x).trim()).join(', ');\n    }\n\n    return [\n      m.venueName,\n      m.venue_name,\n      m.stadium,\n      m.stadiumName,\n      m.city,\n      m.country\n    ].filter(x => x && String(x).trim()).join(', ');\n  }\n\n  function normalizeScheduleMatch(m) {\n    return {\n      d: m.d || m.date || m.startDate,\n      a: m.a || m.away || m.awayTeam || '',\n      h: m.h || m.home || m.homeTeam || '',\n      an: m.an || m.awayName || m.aName || m.a || '',\n      hn: m.hn || m.homeName || m.hName || m.h || '',\n      af: m.af || m.awayFlag || m.awayLogo || '',\n      hf: m.hf || m.homeFlag || m.homeLogo || '',\n      as: scoreValue(m.as ?? m.awayScore),\n      hs: scoreValue(m.hs ?? m.homeScore),\n      aps: scoreValue(m.aps ?? m.awayPenaltyScore ?? m.awayPenalties),\n      hps: scoreValue(m.hps ?? m.homePenaltyScore ?? m.homePenalties),\n      s: m.s || m.state || m.status || 'pre',\n      det: m.det || m.detail || m.shortDetail || '',\n      rnd: m.rnd || m.round || m.stage || '',\n      group: m.group || m.grp || m.g || '',\n      v: venueTextFromMatch(m)\n    };\n  }\n\n  function findLiveNetherlandsMatch() {\n    for (const e of events) {\n      const comp = e.competitions && e.competitions[0];\n      const competitors = (comp && comp.competitors) || [];\n      const statusType = (e.status && e.status.type) || {};\n\n      if (statusType.state !== 'in') continue;\n\n      const found = competitors.find(c => isTargetTeamFromTeam(c.team));\n\n      if (!found) continue;\n\n      const opponent = competitors.find(c => c !== found);\n\n      if (!opponent) continue;\n\n      return {\n        mode: 'live',\n        d: e.date,\n        teamName: teamName(found.team) || TEAM_NAME,\n        teamAbbr: teamAbbr(found.team) || TEAM_ABBR,\n        teamLogo: logo(found.team),\n        opponentName: teamName(opponent.team) || teamAbbr(opponent.team),\n        opponentAbbr: teamAbbr(opponent.team),\n        opponentLogo: logo(opponent.team),\n        teamScore: scoreValue(found.score),\n        opponentScore: scoreValue(opponent.score),\n        status: e.status || {},\n        statusType: statusType,\n        venue: venueTextFromComp(comp),\n        rnd: e.rnd || e.round || '',\n        group: e.group || e.grp || ''\n      };\n    }\n\n    return null;\n  }\n\n  function findNextNetherlandsMatch() {\n    const now = new Date();\n\n    const matches = scheduleMatches\n      .map(normalizeScheduleMatch)\n      .filter(m => {\n        const d = new Date(m.d);\n        if (isNaN(d.getTime())) return false;\n        if (d < now) return false;\n\n        return isTargetAbbr(m.a, m.an) || isTargetAbbr(m.h, m.hn);\n      })\n      .sort((x, y) => new Date(x.d) - new Date(y.d));\n\n    if (!matches.length) return null;\n\n    const m = matches[0];\n    const isAway = isTargetAbbr(m.a, m.an);\n\n    return {\n      mode: 'next',\n      d: m.d,\n      teamName: isAway ? (m.an || TEAM_NAME) : (m.hn || TEAM_NAME),\n      teamAbbr: isAway ? (m.a || TEAM_ABBR) : (m.h || TEAM_ABBR),\n      teamLogo: isAway ? m.af : m.hf,\n      opponentName: isAway ? (m.hn || m.h) : (m.an || m.a),\n      opponentAbbr: isAway ? m.h : m.a,\n      opponentLogo: isAway ? m.hf : m.af,\n      teamScore: '',\n      opponentScore: '',\n      status: {},\n      statusType: { state: 'pre' },\n      venue: m.v,\n      rnd: m.rnd,\n      group: m.group\n    };\n  }\n\n  function getStat(entry, candidates) {\n    const stats = entry.stats || [];\n\n    for (const s of stats) {\n      const keys = [\n        s.name,\n        s.displayName,\n        s.shortDisplayName,\n        s.abbreviation\n      ].filter(Boolean).map(x => String(x).toLowerCase());\n\n      if (keys.some(k => candidates.includes(k))) {\n        return s.displayValue ?? s.value;\n      }\n    }\n\n    return null;\n  }\n\n  function getGroupPosition() {\n    for (const g of groups) {\n      const entries = (g.standings && g.standings.entries) || [];\n\n      for (const entry of entries) {\n        const team = entry.team || {};\n        const abbr = String(team.abbreviation || '').toUpperCase();\n\n        if (abbr !== TEAM_ABBR) continue;\n\n        const rankRaw = getStat(entry, ['rank', 'position']);\n        const points = getStat(entry, ['points', 'pts', 'p']);\n        const played = getStat(entry, ['gamesplayed', 'played', 'gp', 'pld']);\n\n        return {\n          group: g.name || '',\n          rank: rankRaw == null ? null : parseInt(rankRaw),\n          points,\n          played\n        };\n      }\n    }\n\n    return null;\n  }\n\n  function suffixRank(n) {\n    if (!n) return '';\n    if (n === 1) return '1st';\n    if (n === 2) return '2nd';\n    if (n === 3) return '3rd';\n    return `${n}th`;\n  }\n\n  function liveTicker(match) {\n    if (!match || match.mode !== 'live') return '';\n\n    const s = match.status || {};\n    const t = match.statusType || {};\n\n    const shortDetail = String(t.shortDetail || '').toUpperCase();\n    const description = String(t.description || '').toLowerCase();\n\n    if (shortDetail === 'HT' || description.includes('halftime')) {\n      return 'Halftime';\n    }\n\n    return s.displayClock || t.shortDetail || 'Live';\n  }\n\n  function groupInfoLine(groupPos) {\n    if (!groupPos) return '';\n\n    const parts = [];\n\n    if (groupPos.group) parts.push(esc(groupPos.group));\n    if (groupPos.rank) parts.push(esc(suffixRank(groupPos.rank)));\n    if (groupPos.points != null) parts.push(`${esc(groupPos.points)} pts`);\n    if (groupPos.played != null) parts.push(`${esc(groupPos.played)} played`);\n\n    return parts.join(' · ');\n  }\n\n  const selected = findLiveNetherlandsMatch() || findNextNetherlandsMatch();\n\n  if (!selected) return '';\n\n  const groupPos = getGroupPosition();\n\n  const scoreText = selected.mode === 'live'\n    ? `${esc(selected.teamScore || '0')} – ${esc(selected.opponentScore || '0')}`\n    : 'vs';\n\n  const badgeText = selected.mode === 'live' ? 'LIVE' : 'NEXT MATCH';\n  const ticker = liveTicker(selected);\n  const context = matchContext(selected);\n  const standingsLine = groupInfoLine(groupPos);\n\n  return `\n    <style>\n      .wc-ned-wrap {\n        width: 100%;\n        max-width: 100%;\n        min-width: 0;\n        display: flex;\n        justify-content: ${justify};\n        box-sizing: border-box;\n        overflow: hidden;\n      }\n\n      .wc-ned-card {\n        width: 100%;\n        max-width: ${CARD_MAX_WIDTH}px;\n        min-width: 0;\n        border-radius: 18px;\n        padding: clamp(14px, 1.3vw, 22px);\n        display: grid;\n        grid-template-columns:\n          minmax(52px, .85fr)\n          minmax(0, 3.4fr)\n          minmax(52px, .85fr);\n        align-items: center;\n        gap: clamp(8px, 2vw, 34px);\n        border: 1px solid rgba(249,115,22,.24);\n        box-sizing: border-box;\n        background:\n          radial-gradient(circle at top left, rgba(249,115,22,.20), transparent 38%),\n          radial-gradient(circle at bottom right, rgba(249,115,22,.10), transparent 34%),\n          linear-gradient(135deg, rgba(31,34,48,.92), rgba(17,19,33,.88));\n        box-shadow:\n          0 10px 28px rgba(0,0,0,.18),\n          inset 0 1px 0 rgba(255,255,255,.07);\n        overflow: hidden;\n        position: relative;\n      }\n\n      .wc-ned-card::before {\n        content: \"\";\n        position: absolute;\n        inset: 0;\n        pointer-events: none;\n        border-radius: inherit;\n        border-left: 5px solid rgba(249,115,22,.58);\n        opacity: .95;\n      }\n\n      .wc-ned-team {\n        text-align: center;\n        min-width: 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        position: relative;\n        z-index: 1;\n      }\n\n      .wc-ned-logo {\n        height: clamp(34px, 6vw, 118px);\n        max-width: clamp(42px, 8vw, 140px);\n        object-fit: contain;\n        filter: drop-shadow(0 6px 12px rgba(0,0,0,.22));\n      }\n\n      .wc-ned-team-name {\n        color: #f8fafc;\n        font-weight: 850;\n        font-size: clamp(10px, .9vw, 15px);\n        line-height: 1.15;\n        margin-top: 7px;\n        max-width: 100%;\n        white-space: normal;\n        overflow-wrap: anywhere;\n      }\n\n      .wc-ned-center {\n        text-align: center;\n        color: #fff;\n        min-width: 0;\n        width: 100%;\n        position: relative;\n        z-index: 1;\n      }\n\n      .wc-ned-score {\n        color: #fff7ed;\n        font-size: clamp(30px, 5.6vw, 82px);\n        font-weight: 950;\n        line-height: .95;\n        white-space: nowrap;\n        text-shadow: 0 4px 18px rgba(0,0,0,.22);\n      }\n\n      .wc-ned-badge-row {\n        margin-top: clamp(7px, 1vw, 12px);\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        gap: 7px;\n        flex-wrap: wrap;\n        min-width: 0;\n      }\n\n      .wc-ned-badge {\n        border-radius: 999px;\n        padding: 5px 11px;\n        font-size: clamp(10px, .75vw, 11px);\n        font-weight: 950;\n        letter-spacing: .3px;\n        white-space: nowrap;\n        color: #fed7aa;\n        background: rgba(249,115,22,.13);\n        border: 1px solid rgba(249,115,22,.28);\n        flex: 0 0 auto;\n      }\n\n      .wc-ned-badge-live {\n        color: #fecaca;\n        background: rgba(239,68,68,.18);\n        border-color: rgba(239,68,68,.34);\n        box-shadow: 0 0 12px rgba(239,68,68,.22);\n      }\n\n      .wc-ned-context {\n        border-radius: 999px;\n        padding: 5px 11px;\n        font-size: clamp(10px, .75vw, 11px);\n        font-weight: 850;\n        color: #cbd5e1;\n        background: rgba(255,255,255,.08);\n        border: 1px solid rgba(255,255,255,.12);\n        white-space: nowrap;\n      }\n\n      .wc-ned-live-detail {\n        color: #e2e8f0;\n        font-size: clamp(11px, .95vw, 15px);\n        font-weight: 850;\n        opacity: .96;\n        min-width: 0;\n        max-width: 100%;\n        white-space: normal;\n        line-height: 1.2;\n      }\n\n      .wc-ned-standings-line {\n        margin-top: 8px;\n        color: #fed7aa;\n        font-size: clamp(10px, .85vw, 13px);\n        font-weight: 850;\n        line-height: 1.25;\n        opacity: .92;\n        white-space: normal;\n      }\n\n      .wc-ned-meta-grid {\n        margin-top: 10px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        gap: 7px;\n        flex-wrap: wrap;\n        min-width: 0;\n      }\n\n      .wc-ned-meta {\n        min-width: 0;\n        max-width: 100%;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 6px;\n        color: #cbd5e1;\n        font-size: clamp(10px, .85vw, 13px);\n        font-weight: 750;\n        line-height: 1.2;\n        opacity: .94;\n        background: rgba(255,255,255,.06);\n        border: 1px solid rgba(255,255,255,.10);\n        border-radius: 999px;\n        padding: 6px 10px;\n        box-sizing: border-box;\n      }\n\n      .wc-ned-meta span {\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        white-space: nowrap;\n      }\n\n      .wc-ned-icon {\n        width: 13px;\n        height: 13px;\n        fill: currentColor;\n        flex: 0 0 auto;\n        opacity: .86;\n      }\n    </style>\n\n    <div class=\"wc-ned-wrap\">\n      <div class=\"wc-ned-card\">\n        <div class=\"wc-ned-team\">\n          ${selected.teamLogo ? `<img src=\"${selected.teamLogo}\" class=\"wc-ned-logo\">` : ''}\n          <div class=\"wc-ned-team-name\">${esc(selected.teamName || selected.teamAbbr || TEAM_NAME)}</div>\n        </div>\n\n        <div class=\"wc-ned-center\">\n          <div class=\"wc-ned-score\">${scoreText}</div>\n\n          <div class=\"wc-ned-badge-row\">\n            <span class=\"wc-ned-badge ${selected.mode === 'live' ? 'wc-ned-badge-live' : ''}\">${badgeText}</span>\n            ${context ? `<span class=\"wc-ned-context\">${esc(context)}</span>` : ''}\n            ${selected.mode === 'live' && ticker ? `<span class=\"wc-ned-live-detail\">${esc(ticker)}</span>` : ''}\n          </div>\n\n          ${standingsLine ? `\n            <div class=\"wc-ned-standings-line\">${standingsLine}</div>\n          ` : ''}\n\n          <div class=\"wc-ned-meta-grid\">\n            <div class=\"wc-ned-meta\">\n              ${calendarIcon}\n              <span>${fmtDateTime(selected.d)}</span>\n            </div>\n\n            ${selected.venue ? `\n              <div class=\"wc-ned-meta\">\n                ${locationIcon}\n                <span>${esc(selected.venue)}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n\n        <div class=\"wc-ned-team\">\n          ${selected.opponentLogo ? `<img src=\"${selected.opponentLogo}\" class=\"wc-ned-logo\">` : ''}\n          <div class=\"wc-ned-team-name\">${esc(selected.opponentName || selected.opponentAbbr || 'TBD')}</div>\n        </div>\n      </div>\n    </div>\n  `;\n]]]"
                  },
                  "styles": {
                    "card": [
                      {
                        "display": "[[[\n  const sb = states['sensor.world_cup_scoreboard'];\n  const sch = states['sensor.world_cup_schedule'];\n\n  const events = (sb && sb.attributes && sb.attributes.events) || [];\n  const matches = (sch && sch.attributes && sch.attributes.matches) || [];\n\n  const TEAM_ABBR = String(variables.team_abbr || 'NED').toUpperCase();\n  const now = new Date();\n\n  const live = events.some(e => {\n    const comp = e.competitions && e.competitions[0];\n    const competitors = (comp && comp.competitors) || [];\n    const state = e.status && e.status.type && e.status.type.state;\n\n    if (state !== 'in') return false;\n\n    return competitors.some(c => {\n      const t = c && c.team;\n      return String(t && t.abbreviation || '').toUpperCase() === TEAM_ABBR;\n    });\n  });\n\n  const next = matches.some(m => {\n    const d = new Date(m.d || m.date || m.startDate);\n    if (isNaN(d.getTime()) || d < now) return false;\n\n    return String(m.a || m.away || '').toUpperCase() === TEAM_ABBR ||\n      String(m.h || m.home || '').toUpperCase() === TEAM_ABBR;\n  });\n\n  return live || next ? 'block' : 'none';\n]]]"
                      },
                      {
                        "background": "transparent"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "border": "none"
                      },
                      {
                        "padding": 0
                      },
                      {
                        "margin": 0
                      },
                      {
                        "width": "100%"
                      },
                      {
                        "max-width": "100%"
                      },
                      {
                        "min-width": 0
                      },
                      {
                        "overflow": "hidden"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "\"content\""
                      },
                      {
                        "grid-template-columns": "1fr"
                      },
                      {
                        "justify-items": "stretch"
                      },
