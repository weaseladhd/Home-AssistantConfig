                {
                  "type": "custom:apexcharts-card",
                  "header": {
                    "show": true,
                    "title": "Kleenex Pollen Radar (Home) - Trees",
                    "show_states": true,
                    "colorize_states": true
                  },
                  "now": {
                    "show": true
                  },
                  "graph_span": "4d",
                  "span": {
                    "start": "day",
                    "offset": "+1d"
                  },
                  "series": [
                    {
                      "name": "Hazelaar",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#1f77b4",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Hazelaar\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Hazelaar\").value]));\n"
                    },
                    {
                      "name": "Iep",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#ff7f0e",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Iep\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Iep\").value]));\n"
                    },
                    {
                      "name": "Els",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#2ca02c",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Els\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Els\").value]));\n"
                    },
                    {
                      "name": "Populier",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#d62728",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Populier\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Populier\").value]));\n"
                    },
                    {
                      "name": "Eik",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#9467bd",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Eik\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Eik\").value]));\n"
                    },
                    {
                      "name": "Plataan",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#8c564b",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Plataan\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Plataan\").value]));\n"
                    },
                    {
                      "name": "Berk",
                      "entity": "sensor.kleenex_pollen_radar_lbl_16_trees",
                      "type": "column",
                      "color": "#e377c2",
                      "data_generator": "let data = [];\nif (entity.attributes.current) {\n  data.push([new Date(entity.attributes.current.date).getTime(), entity.attributes.current.details.find(t => t.name === \"Berk\").value]);\n}\nreturn data.concat(entity.attributes.forecast.map(d => [new Date(d.date).getTime(), d.details.find(t => t.name === \"Berk\").value]));\n"
                    },
                    {
