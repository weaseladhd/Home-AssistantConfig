          "header": {
            "card": {
              "type": "markdown",
              "content": "# Lights\n{% set daylight = ( state_attr('sun.sun', 'next_rising') | as_timestamp(0) - state_attr('sun.sun', 'next_setting') | as_timestamp(0) ) | abs / 60 / 60 %}\nYou have {{ states.light|length }} lights and {{ states.light|selectattr('state','equalto','on')|list|length }} of them {{ iif((states.light|selectattr('state','equalto','on')|list|length == 1), 'is', 'are') }}  turned on. There is {{ daylight | round(1) }} hours of daylight and {{ 24 - daylight | round(1) }} hours of nighttime today.",
              "text_only": true
            },
            "layout": "responsive",
            "badges_position": "bottom"
          },
          "subview": false,
          "top_margin": false,
          "dense_section_placement": false
        },
        {
          "type": "sections",
          "max_columns": 4,
          "title": "Environment",
          "path": "new",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Comfort",
                  "heading_style": "title",
                  "icon": "mdi:sofa"
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "entity",
                      "entity": "sensor.irosma27_dewpoint",
                      "name": "Dew Point",
                      "icon": "none",
                      "card_mod": {
                        "style": "ha-card {background: none;}\n"
                      }
                    },
                    {
                      "type": "entity",
                      "entity": "sensor.thermal_comfort_outside_absolutehumidity",
                      "name": "Absolute Humidity",
                      "icon": "none",
                      "card_mod": {
                        "style": "ha-card {background: none;}\n"
                      }
                    },
                    {
                      "type": "custom:gap-card"
                    }
                  ]
                },
                {
                  "type": "custom:floorplan-card",
                  "card_mod": {
                    "style": "ha-card {margin-top: -100px; background: none;}\n"
                  },
                  "config": {
                    "image": {
                      "location": "/local/psychrometry-chart.svg",
                      "cache": false
                    },
                    "stylesheet": "/local/psychrometry-chart.css",
                    "defaults": {
                      "hover_action": "hover-info",
                      "tap_action": "more-info"
                    },
                    "rules": [
                      {
                        "entity": "sensor.bedroom_fan_temperature",
                        "state_action": {
                          "action": "call-service",
                          "service": "floorplan.style_set",
                          "service_data": {
                            "element": "indicator-bedroom",
                            "style": ">\nvar x = (parseFloat(entity.state) + 20) / 65 * 1007 - 11;\nvar y = 665 - (parseFloat(states['sensor.thermal_comfort_bedroom_absolutehumidity'].state) / 35 * 665) - 155;\nreturn `transform: translate(${x}px, ${y}px);`;\n"
                          }
                        }
                      },
                      {
                        "entity": "sensor.bathroom_sensor_temperature",
                        "state_action": {
                          "action": "call-service",
                          "service": "floorplan.style_set",
                          "service_data": {
                            "element": "indicator-bathroom",
                            "style": ">\nvar x = (parseFloat(entity.state) + 20) / 65 * 1007 - 244;\nvar y = 665 - (parseFloat(states['sensor.thermal_comfort_bathroom_absolutehumidity'].state) / 35 * 665) - 155;\nreturn `transform: translate(${x}px, ${y}px);`;\n"
                          }
                        }
                      },
                      {
                        "entity": "sensor.irosma27_temperature",
                        "state_action": {
                          "action": "call-service",
                          "service": "floorplan.style_set",
                          "service_data": {
                            "element": "indicator-outdoor",
                            "style": ">\nvar x = (parseFloat(entity.state) + 20) / 65 * 1007 - 229;\nvar y = 665 - (parseFloat(states['sensor.thermal_comfort_outside_absolutehumidity'].state) / 35 * 665) - 155;\nreturn `transform: translate(${x}px, ${y}px);`;\n"
                          }
                        }
                      },
                      {
                        "entity": "sensor.avg_temp_downstairs",
                        "state_action": {
                          "action": "call-service",
                          "service": "floorplan.style_set",
                          "service_data": {
                            "element": "indicator-indoor",
                            "style": ">\nvar x = (parseFloat(entity.state) + 20) / 65 * 1007 - 343;\nvar y = 665 - (parseFloat(states['sensor.thermal_comfort_living_room_absolutehumidity'].state) / 35 * 665) - 241;\nreturn `transform: translate(${x}px, ${y}px);`;\n"
                          }
                        }
                      },
                      {
                        "entity": "sensor.study_fan_temperature",
                        "state_action": {
                          "action": "call-service",
                          "service": "floorplan.style_set",
                          "service_data": {
                            "element": "indicator-study",
                            "style": ">\nvar x = (parseFloat(entity.state) + 20) / 65 * 1007 - 383;\nvar y = 665 - (parseFloat(states['sensor.thermal_comfort_study_absolutehumidity'].state) / 35 * 665) - 241;\nreturn `transform: translate(${x}px, ${y}px);`;\n"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "markdown",
                  "content": "<table width=\"100%\">\n  <tr>\n    <th>Area</th>\n    <th>Temperature</th>\n    <th>Humidity</th>\n  </tr>\n  <tr>\n    <td>Outdoor</td>\n    <td>{{ states('sensor.thermal_comfort_outside_simmerzone') | regex_replace(find='_', replace=' ') | title }}</td>\n    <td>{{ states('sensor.thermal_comfort_outside_perception') | regex_replace(find='_', replace=' ') | title }}</td>\n  </tr>\n  <tr>\n    <td>Living Room</td>\n    <td>{{ states('sensor.thermal_comfort_living_room_simmerzone') | regex_replace(find='_', replace=' ') | title }}</td>\n    <td>{{ states('sensor.thermal_comfort_living_room_perception') | regex_replace(find='_', replace=' ') | title }}</td>\n  </tr>\n  <tr>\n    <td>Bedroom</td>\n    <td>{{ states('sensor.thermal_comfort_bedroom_simmerzone') | regex_replace(find='_', replace=' ') | title }}</td>\n    <td>{{ states('sensor.thermal_comfort_bedroom_perception') | regex_replace(find='_', replace=' ') | title }}</td>\n  </tr>\n  <tr>\n    <td>Study</td>\n    <td>{{ states('sensor.thermal_comfort_study_simmerzone') | regex_replace(find='_', replace=' ') | title }}</td>\n    <td>{{ states('sensor.thermal_comfort_study_perception') | regex_replace(find='_', replace=' ') | title }}</td>\n  </tr>\n  <tr>\n    <td>Bathroom</td>\n    <td>{{ states('sensor.thermal_comfort_bathroom_simmerzone') | regex_replace(find='_', replace=' ') | title }}</td>\n    <td>{{ states('sensor.thermal_comfort_bathroom_perception') | regex_replace(find='_', replace=' ') | title }}</td>\n  </tr>\n</table>",
                  "card_mod": {
                    "style": {
                      "ha-markdown$": "th, td { padding: 2px 0 2px; border-bottom: 1px solid,.05);}\nth { font-size: var(--h6-font-size); text-align: left; padding-top: 0 !important; }\nxth, xtr:last-child td { border-bottom: 1px solid) !important; }\n"
                    }
                  }
                },
                {
                  "type": "history-graph",
                  "entities": [
                    {
                      "entity": "binary_sensor.bedroom_window_sensor_contact",
                      "name": "Bedroom"
                    },
                    {
                      "entity": "binary_sensor.study_window_sensor_contact",
                      "name": "Study"
                    },
                    {
                      "entity": "binary_sensor.bedroom_2_window_sensor_contact",
                      "name": "Baby room"
                    }
                  ],
                  "hours_to_show": 48,
                  "title": "Window Sensors",
                  "card_mod": {
                    "style": ".card-header {\n  padding: 16px !important;\n  margin: 0 !important;\n  font-size: var(--body-font-size);\n  font-weight: var(--body-font-weight);\n  line-height: var(--body-line-height);\n}\n"
                  }
                },
                {
                  "entity": "sensor.kleenex_pollen_radar_lbl_16_weeds",
                  "name": "Weeds",
                  "type": "tile",
                  "vertical": true,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "features_position": "bottom",
                  "card_mod": {
                    "style": ".icon-container {\n  {% set level = states('sensor.pollen_weeds_concentration') %}\n  {% set color = {'Low':'green','Average':'orange','High':'darkorange','Zeer High':'maroon'} %}\n  {% set level_color = color.get(level,'gray') %}\n  {% set circle = {'Low':'25','Average':'50','High':'75','Zeer High':'100'} %}        \n  {% set percentage = circle.get(level,'25') %}\n  border-radius: 24px;\n  background: radial-gradient(var(--card-background-color) 60%,transparent calc(60% + 1px)),\n  conic-gradient({{level_color}} {{percentage}}% 0%,\n  var(--card-background-color) 0% 100%);\n}\nha-tile-icon {\n  {% set level = states('sensor.pollen_weeds_concentration') %}\n  {% set color = {'Low':'green','Average':'orange', 'High':'darkorange','Zeer High':'maroon'} %}              \n  {% set level_color = color.get(level,'gray') %}\n  --tile-color: {{level_color}};\n}\n"
                  },
                  "grid_options": {
                    "columns": 4,
                    "rows": 2
                  }
                },
