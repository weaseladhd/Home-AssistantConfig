              "column_span": 4,
              "visibility": [
                {
                  "condition": "state",
                  "entity": "input_boolean.wc_show_knockout",
                  "state": "on"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "entity": "sensor.world_cup_schedule",
                  "triggers_update": [
                    "sensor.world_cup_schedule",
                    "sensor.world_cup_scoreboard",
                    "sensor.world_cup_standings"
                  ],
                  "show_icon": false,
                  "show_name": true,
                  "show_state": false,
                  "show_label": false,
                  "tap_action": {
                    "action": "none"
                  },
                  "hold_action": {
                    "action": "none"
                  },
                  "double_tap_action": {
                    "action": "none"
                  },
                  "name": "[[[\n  const ids = [\n    'sensor.world_cup_schedule',\n    'sensor.world_cup_scoreboard',\n    'sensor.world_cup_standings'\n  ];\n\n  const dates = ids\n    .map(id => states[id])\n    .filter(Boolean)\n    .map(s => new Date(s.last_updated || s.last_changed))\n    .filter(d => !isNaN(d.getTime()))\n    .sort((a, b) => b - a);\n\n  const latest = dates[0];\n\n  const text = latest\n    ? latest.toLocaleString([], {\n        weekday: 'short',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      })\n    : 'Unknown';\n\n  return `Last updated: ${text}`;\n]]]",
                  "styles": {
                    "card": [
                      {
                        "width": "100%"
                      },
                      {
                        "max-width": "100%"
                      },
                      {
                        "min-width": 0
                      },
                      {
                        "box-sizing": "border-box"
                      },
                      {
                        "padding": "7px 10px"
                      },
                      {
                        "margin": 0
                      },
                      {
                        "border-radius": "12px"
                      },
                      {
                        "background": "rgba(24,26,36,.45)"
                      },
                      {
                        "border": "1px solid rgba(255,255,255,.07)"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "overflow": "hidden"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "\"n\""
                      },
                      {
                        "grid-template-columns": "1fr"
                      },
                      {
                        "width": "100%"
                      },
                      {
                        "min-width": 0
                      }
                    ],
                    "name": [
                      {
                        "justify-self": "stretch"
                      },
                      {
                        "width": "100%"
                      },
                      {
                        "min-width": 0
                      },
                      {
                        "text-align": "right"
                      },
                      {
                        "color": "#94a3b8"
                      },
                      {
                        "font-size": "11px"
                      },
                      {
                        "font-weight": 650
                      },
                      {
                        "white-space": "nowrap"
                      },
                      {
                        "overflow": "hidden"
                      },
                      {
                        "text-overflow": "ellipsis"
                      }
                    ]
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": 1
                  },
                  "view_layout": {
                    "grid-column": "1 / -1"
                  }
                }
              ],
              "column_span": 4
            }
