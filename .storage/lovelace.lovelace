                  "apex_config": {
                    "chart": {
                      "height": "200px"
                    },
                    "legend": {
                      "show": false
                    }
                  },
                  "header": {
                    "show": true,
                    "title": "Indoor AQI",
                    "show_states": true,
                    "colorize_states": true
                  },
                  "all_series_config": {
                    "stroke_width": 2,
                    "type": "line",
                    "color": "black",
                    "group_by": {
                      "duration": "10m",
                      "func": "avg"
                    },
                    "transform": "return Math.round(x)",
                    "show": {
                      "header_color_threshold": true,
                      "extremas": true
                    },
                    "color_threshold": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 51,
                        "color": "yellow"
                      },
                      {
                        "value": 101,
                        "color": "orange"
                      },
                      {
                        "value": 151,
                        "color": "red"
                      },
                      {
                        "value": 201,
                        "color": "rgb(143, 63, 151)"
                      },
                      {
                        "value": 300,
                        "color": "rgb(126,0,35)"
                      }
                    ],
                    "fill_raw": "last"
                  },
                  "experimental": {
                    "color_threshold": true
                  },
                  "series": [
