                      "variables": {
                        "group": "G",
                        "favorite_team": "NED"
                      }
                    },
                    {
                      "type": "custom:button-card",
                      "template": "wc_group_card",
                      "variables": {
                        "group": "H",
                        "favorite_team": "NED"
                      }
                    },
                    {
                      "type": "custom:button-card",
                      "template": "wc_group_card",
                      "variables": {
                        "group": "I",
                        "favorite_team": "NED"
                      }
                    },
                    {
                      "type": "custom:button-card",
                      "template": "wc_group_card",
                      "variables": {
                        "group": "J",
                        "favorite_team": "NED"
                      }
                    },
                    {
                      "type": "custom:button-card",
                      "template": "wc_group_card",
                      "variables": {
                        "group": "K",
                        "favorite_team": "NED"
                      }
                    },
                    {
                      "type": "custom:button-card",
                      "template": "wc_group_card",
                      "variables": {
                        "group": "L",
                        "favorite_team": "NED"
                      }
                    }
                  ],
                  "view_layout": {
                    "grid-column": "1 / -1"
                  }
                }
              ],
              "column_span": 4,
              "visibility": [
                {
                  "condition": "state",
                  "entity": "input_boolean.wc_show_groups",
                  "state": "on"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "icon": "mdi:tournament",
                  "heading": "Knockout Stage",
                  "heading_style": "title"
                },
                {
                  "type": "custom:button-card",
                  "entity": "sensor.world_cup_schedule",
                  "triggers_update": [
                    "sensor.world_cup_schedule",
                    "sensor.world_cup_standings",
                    "sensor.world_cup_scoreboard"
                  ],
                  "show_icon": false,
                  "show_name": false,
                  "show_state": false,
                  "show_label": false,
                  "tap_action": {
                    "action": "none"
                  },
                  "variables": {
                    "favorite_team": "NED"
                  },
                  "custom_fields": {
                    "content": "[[[\n  const sch = states['sensor.world_cup_schedule'];\n  const stn = states['sensor.world_cup_standings'];\n  const all = (sch && sch.attributes && sch.attributes.matches) || [];\n  const groups = (stn && stn.attributes && stn.attributes.children) || [];\n\n  const esc = s => (s == null ? '' : String(s));\n  const FAV = String(variables.favorite_team || 'NED').toUpperCase();\n\n  // Desktop bracket settings\n  const desktopMinWidth = 1500;\n  const desktopFullBleedMargin = 190;\n\n  // List mode settings\n  const listSwitchWidth = 800;\n\n  const calendarIcon = `\n    <svg class=\"wc-meta-svg\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1.5A2.5 2.5 0 0 1 22 6.5v12A2.5 2.5 0 0 1 19.5 21h-15A2.5 2.5 0 0 1 2 18.5v-12A2.5 2.5 0 0 1 4.5 4H6V3a1 1 0 0 1 1-1Zm12.5 8h-15v8.5a.5.5 0 0 0 .5.5h14a.5.5 0 0 0 .5-.5V10ZM5 6a.5.5 0 0 0-.5.5V8h15V6.5A.5.5 0 0 0 19 6H5Z\"/>\n    </svg>\n  `;\n\n  const locationIcon = `\n    <svg class=\"wc-meta-svg\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z\"/>\n    </svg>\n  `;\n\n  const flag = u => u\n    ? `<img src=\"${u}\" class=\"wc-flag\">`\n    : '';\n\n  function scoreValue(raw) {\n    if (raw == null || raw === '') return '';\n\n    if (typeof raw === 'object') {\n      return raw.displayValue ?? raw.value ?? raw.score ?? '';\n    }\n\n    return raw;\n  }\n\n  function scoreNumber(raw) {\n    const val = scoreValue(raw);\n\n    if (val === '') return null;\n\n    const n = Number(val);\n\n    return Number.isFinite(n) ? n : null;\n  }\n\n  function penaltyValue(raw) {\n    const val = scoreValue(raw);\n  \n    if (val === '') return '';\n  \n    return val;\n  }\n  \n  function penaltyScore(m, side) {\n    if (!m) return '';\n  \n    if (side === 'a') {\n      return penaltyValue(\n        m.aps ??\n        m.ap ??\n        m.awayPenaltyScore ??\n        m.awayPenalties ??\n        m.awayShootoutScore\n      );\n    }\n  \n    return penaltyValue(\n      m.hps ??\n      m.hp ??\n      m.homePenaltyScore ??\n      m.homePenalties ??\n      m.homeShootoutScore\n    );\n  }\n  \n  function hasPens(m) {\n    return penaltyScore(m, 'a') !== '' || penaltyScore(m, 'h') !== '';\n  }\n\n  function resultInfo(m) {\n    if (!m || m.s !== 'post') {\n      return {\n        result: 'none',\n        awayClass: '',\n        homeClass: ''\n      };\n    }\n  \n    const awayScore = scoreNumber(m.as);\n    const homeScore = scoreNumber(m.hs);\n  \n    const awayPens = scoreNumber(penaltyScore(m, 'a'));\n    const homePens = scoreNumber(penaltyScore(m, 'h'));\n  \n    if (awayPens !== null && homePens !== null && awayPens !== homePens) {\n      if (awayPens > homePens) {\n        return {\n          result: 'away-win',\n          awayClass: 'wc-team-row-win',\n          homeClass: 'wc-team-row-lose'\n        };\n      }\n  \n      return {\n        result: 'home-win',\n        awayClass: 'wc-team-row-lose',\n        homeClass: 'wc-team-row-win'\n      };\n    }\n  \n    if (awayScore === null || homeScore === null) {\n      return {\n        result: 'none',\n        awayClass: '',\n        homeClass: ''\n      };\n    }\n  \n    if (awayScore === homeScore) {\n      return {\n        result: 'draw',\n        awayClass: 'wc-team-row-draw',\n        homeClass: 'wc-team-row-draw'\n      };\n    }\n  \n    if (awayScore > homeScore) {\n      return {\n        result: 'away-win',\n        awayClass: 'wc-team-row-win',\n        homeClass: 'wc-team-row-lose'\n      };\n    }\n  \n    return {\n      result: 'home-win',\n      awayClass: 'wc-team-row-lose',\n      homeClass: 'wc-team-row-win'\n    };\n  }\n\n  const gp = {};\n\n  groups.forEach(g => {\n    const L = (g.name || '').trim().slice(-1);\n    gp[L] = {};\n\n    ((g.standings && g.standings.entries) || []).forEach(en => {\n      let rk = 99;\n\n      for (const s of (en.stats || [])) {\n        if (s.name === 'rank') rk = parseInt(s.value);\n      }\n\n      gp[L][rk] = {\n        ab: en.team.abbreviation,\n        fl: (en.team.logos && en.team.logos[0] ? en.team.logos[0].href : '')\n      };\n    });\n  });\n\n  function project(ab) {\n    const m = (ab || '').match(/^([12])([A-L])$/);\n\n    if (m) {\n      const t = gp[m[2]] && gp[m[2]][+m[1]];\n      if (t && t.ab) return t;\n    }\n\n    return null;\n  }\n\n  function slot(ab, nm) {\n    if (/^([12])([A-L])$/.test(ab || '')) return ab;\n    if (ab === '3RD') return '3rd place';\n\n    const m = (nm || '').match(/Round of (\\d+) (\\d+) Winner/);\n    if (m) return 'R' + m[1] + ' W' + m[2];\n\n    return ab || nm || 'TBD';\n  }\n\n  function statusInfo(m) {\n    if (!m) {\n      return {\n        cls: 'scheduled',\n        label: 'TBD'\n      };\n    }\n  \n    if (m.s === 'in') {\n      return {\n        cls: 'live',\n        label: 'LIVE'\n      };\n    }\n  \n    if (m.s === 'post') {\n      const ri = resultInfo(m);\n      const det = String(m.det || m.detail || m.shortDetail || '').toUpperCase();\n  \n      if (hasPens(m)) {\n        return {\n          cls: 'pens',\n          label: 'PENS'\n        };\n      }\n  \n      if (det.includes('AET')) {\n        return {\n          cls: 'aet',\n          label: 'AET'\n        };\n      }\n  \n      if (ri.result === 'draw') {\n        return {\n          cls: 'draw',\n          label: 'DRAW'\n        };\n      }\n  \n      return {\n        cls: 'finished',\n        label: 'FINISHED'\n      };\n    }\n  \n    return {\n      cls: 'scheduled',\n      label: 'SCHEDULED'\n    };\n  }\n\n  function venueLine(m) {\n    if (!m) return '';\n\n    const comp = (m.competitions && m.competitions[0]) || {};\n    const rawVenue = m.venue || m.v || comp.venue || {};\n\n    let venueName = '';\n    let city = '';\n    let country = '';\n\n    if (typeof rawVenue === 'string') {\n      venueName = rawVenue;\n    } else if (rawVenue && typeof rawVenue === 'object') {\n      const address = rawVenue.address || {};\n\n      venueName =\n        rawVenue.fullName ||\n        rawVenue.name ||\n        rawVenue.displayName ||\n        rawVenue.shortName ||\n        '';\n\n      city =\n        address.city ||\n        rawVenue.city ||\n        rawVenue.venueCity ||\n        '';\n\n      country =\n        address.country ||\n        rawVenue.country ||\n        rawVenue.venueCountry ||\n        '';\n    }\n\n    venueName =\n      venueName ||\n      m.venueName ||\n      m.venue_name ||\n      m.stadium ||\n      m.stadiumName ||\n      m.location ||\n      m.vname ||\n      '';\n\n    city =\n      city ||\n      m.city ||\n      m.venueCity ||\n      m.venue_city ||\n      '';\n\n    country =\n      country ||\n      m.country ||\n      m.venueCountry ||\n      m.venue_country ||\n      '';\n\n    return [\n      venueName,\n      city,\n      country\n    ].filter(x => x && String(x).trim()).join(', ');\n  }\n\n  const byR = {};\n\n  all.forEach(m => {\n    if (m.rnd && m.rnd !== 'group-stage') {\n      (byR[m.rnd] = byR[m.rnd] || []).push(m);\n    }\n  });\n\n  Object.values(byR).forEach(a =>\n    a.sort((x, y) => x.d < y.d ? -1 : (x.d > y.d ? 1 : 0))\n  );\n\n  function teamRow(m, side, mode) {\n    const isList = mode === 'list';\n\n    if (!m) {\n      return `\n        <div class=\"wc-team-row ${isList ? 'wc-team-row-list' : ''}\">\n          <span class=\"wc-team-label wc-tbd-label\">TBD</span>\n          <span class=\"wc-team-score\"></span>\n        </div>\n      `;\n    }\n\n    const ri = resultInfo(m);\n\n    const ab = side === 'a' ? m.a : m.h;\n    const nm = side === 'a' ? m.an : m.hn;\n    const fl = side === 'a' ? m.af : m.hf;\n    const sc = side === 'a' ? m.as : m.hs;\n    const penSc = penaltyScore(m, side);\n    const resultClass = side === 'a' ? ri.awayClass : ri.homeClass;\n    \n    const showScore = m.s !== 'pre' && sc != null;\n    const showPenScore = m.s === 'post' && penSc !== '';\n\n    const fav = String(ab || label || '').toUpperCase() === FAV;\n\n    const favStar = fav\n      ? `<span class=\"wc-fav-star wc-fav-star-bracket\" title=\"Favorite team\">★</span>`\n      : '';\n\n    let fh = '';\n    let label = '';\n    let projected = false;\n    let tbd = false;\n\n    if (fl) {\n      fh = flag(fl);\n      label = ab || nm;\n    } else {\n      const pr = project(ab);\n\n      if (pr) {\n        fh = flag(pr.fl);\n        label = pr.ab;\n        projected = true;\n      } else {\n        label = slot(ab, nm);\n        tbd = true;\n      }\n    }\n\n    return `\n      <div class=\"\n        wc-team-row\n        ${isList ? 'wc-team-row-list' : ''}\n        ${resultClass}\n      \">\n        <span class=\"\n          wc-team-label\n          ${projected ? 'wc-projected-label' : ''}\n          ${tbd ? 'wc-tbd-label' : ''}\n        \">\n          ${fh}${esc(label)}${favStar}\n        </span>\n\n        <span class=\"wc-team-score\">\n          ${showScore ? esc(scoreValue(sc)) : ''}\n          ${showPenScore ? `<span class=\"wc-team-pen-score\">(${esc(penSc)})</span>` : ''}\n        </span>\n      </div>\n    `;\n  }\n\n  function metaLine(m, mode) {\n    const isList = mode === 'list';\n\n    if (!m || !m.d) {\n      return `\n        <div class=\"wc-meta-block ${isList ? 'wc-meta-block-list' : ''}\">\n          <div class=\"wc-meta-row\">\n            ${calendarIcon}\n            <span class=\"wc-meta-text\">TBD</span>\n          </div>\n        </div>\n      `;\n    }\n\n    let dt;\n\n    try {\n      dt = new Date(m.d).toLocaleString([], {\n        day: 'numeric',\n        month: 'short',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    } catch(e) {\n      dt = m.d;\n    }\n\n    const info = statusInfo(m);\n    const showPill = info.cls === 'live' || info.cls === 'finished' || info.cls === 'draw';\n    const venue = venueLine(m);\n\n    return `\n      <div class=\"wc-meta-block ${isList ? 'wc-meta-block-list' : ''}\">\n        <div class=\"wc-meta-row\">\n          ${showPill ? `<span class=\"wc-status-pill wc-status-${info.cls}\">${info.label}</span>` : ''}\n          ${calendarIcon}\n          <span class=\"wc-meta-text\">${esc(dt)}</span>\n        </div>\n\n        ${venue ? `\n          <div class=\"wc-meta-row wc-location-row\">\n            ${locationIcon}\n            <span class=\"wc-meta-text\">${esc(venue)}</span>\n          </div>\n        ` : ''}\n      </div>\n    `;\n  }\n\n  function box(m) {\n    const info = statusInfo(m);\n\n    return `\n      <div class=\"wc-match-box wc-match-${info.cls}\">\n        ${teamRow(m, 'a', 'bracket')}\n        <div class=\"wc-team-divider\"></div>\n        ${teamRow(m, 'h', 'bracket')}\n        ${metaLine(m, 'bracket')}\n      </div>\n    `;\n  }\n\n  function listBox(m) {\n    const info = statusInfo(m);\n\n    return `\n      <div class=\"wc-list-outer\">\n        <div class=\"wc-match-box wc-list-box wc-match-${info.cls}\">\n          ${teamRow(m, 'a', 'list')}\n          <div class=\"wc-team-divider\"></div>\n          ${teamRow(m, 'h', 'list')}\n          ${metaLine(m, 'list')}\n        </div>\n      </div>\n    `;\n  }\n\n  function col(round, side, per) {\n    const data = byR[round] || [];\n    const half = Math.ceil(data.length / 2);\n\n    const slots = side === 'c'\n      ? data.slice(0, per)\n      : (side === 'l' ? data.slice(0, half) : data.slice(half));\n\n    let b = '';\n\n    for (let i = 0; i < per; i++) {\n      b += box(slots[i]);\n    }\n\n    return `\n      <div class=\"wc-round-column\">\n        ${b}\n      </div>\n    `;\n  }\n\n  const hdr = t => `\n    <div class=\"wc-round-label\">\n      ${t}\n    </div>\n  `;\n\n  const cw = (l, i) => `\n    <div class=\"wc-round-wrap\">\n      ${hdr(l)}\n      ${i}\n    </div>\n  `;\n\n  const finalM = (byR['final'] || [])[0];\n\n  let champion = `\n    <div class=\"wc-champion-trophy\">🏆</div>\n    <div class=\"wc-champion-name\">TBD</div>\n  `;\n\n  if (finalM && finalM.s === 'post') {\n    const aw = scoreNumber(finalM.as);\n    const hw = scoreNumber(finalM.hs);\n  \n    const w = aw > hw\n      ? { f: finalM.af, n: finalM.a }\n      : (hw > aw ? { f: finalM.hf, n: finalM.h } : null);\n  \n    if (w) {\n      champion = `\n        ${w.f ? `<img src=\"${w.f}\" class=\"wc-champion-flag\">` : '<div class=\"wc-champion-trophy\">🏆</div>'}\n        <div class=\"wc-champion-name\">${esc(w.n)}</div>\n      `;\n    }\n  }\n\n  const left =\n    cw('R32', col('round-of-32', 'l', 8)) +\n    cw('R16', col('round-of-16', 'l', 4)) +\n    cw('QF', col('quarterfinals', 'l', 2)) +\n    cw('SF', col('semifinals', 'l', 1));\n\n  const right =\n    cw('SF', col('semifinals', 'r', 1)) +\n    cw('QF', col('quarterfinals', 'r', 2)) +\n    cw('R16', col('round-of-16', 'r', 4)) +\n    cw('R32', col('round-of-32', 'r', 8));\n\n  const center = `\n    <div class=\"wc-center-column\">\n      ${hdr('FINAL MATCH')}\n      ${box(finalM)}\n\n      <div class=\"wc-champion-card\">\n        <div class=\"wc-champion-label\">CHAMPION</div>\n        <div class=\"wc-champion-body\">\n          ${champion}\n        </div>\n      </div>\n    </div>\n  `;\n\n  const roundMap = [\n    ['Round of 32', byR['round-of-32'] || []],\n    ['Round of 16', byR['round-of-16'] || []],\n    ['Quarterfinals', byR['quarterfinals'] || []],\n    ['Semifinals', byR['semifinals'] || []],\n    ['Final Match', byR['final'] || []]\n  ];\n\n  const mobileList = roundMap.map(([title, matches]) => {\n    const items = matches.length\n      ? matches.map(m => listBox(m)).join('')\n      : '<div class=\"wc-mobile-empty\">No matches yet.</div>';\n\n    return `\n      <div class=\"wc-mobile-round\">\n        <div class=\"wc-mobile-round-title\">\n          ${title}\n        </div>\n\n        <div class=\"wc-mobile-round-grid\">\n          ${items}\n        </div>\n      </div>\n    `;\n  }).join('');\n\n  return `\n    <style>\n      @keyframes wcLivePulse {\n        0% {\n          box-shadow: 0 0 8px rgba(239,68,68,.22);\n        }\n\n        50% {\n          box-shadow: 0 0 18px rgba(239,68,68,.52);\n        }\n\n        100% {\n          box-shadow: 0 0 8px rgba(239,68,68,.22);\n        }\n      }\n\n      .wc-bracket-scroll {\n        position: relative;\n        left: 50%;\n        transform: translateX(-50%);\n        width: calc(100vw - ${desktopFullBleedMargin}px);\n        max-width: calc(100vw - ${desktopFullBleedMargin}px);\n        overflow-x: auto;\n        overflow-y: visible;\n        padding: 6px 16px 44px 16px;\n        box-sizing: border-box;\n        scrollbar-width: thin;\n      }\n\n      .wc-bracket-scroll::-webkit-scrollbar {\n        height: 10px;\n      }\n\n      .wc-bracket-scroll::-webkit-scrollbar-thumb {\n        background: rgba(148,163,184,.45);\n        border-radius: 999px;\n      }\n\n      .wc-bracket-scroll::-webkit-scrollbar-track {\n        background: rgba(255,255,255,.06);\n        border-radius: 999px;\n      }\n\n      .wc-desktop-bracket {\n        display: grid;\n        grid-template-columns:\n          minmax(180px, 1.45fr)\n          minmax(155px, 1.12fr)\n          minmax(135px, .95fr)\n          minmax(115px, .78fr)\n          minmax(145px, .92fr)\n          minmax(115px, .78fr)\n          minmax(135px, .95fr)\n          minmax(155px, 1.12fr)\n          minmax(180px, 1.45fr);\n        gap: clamp(8px, .65vw, 14px);\n        align-items: stretch;\n        width: 100%;\n        min-width: ${desktopMinWidth}px;\n        min-height: clamp(760px, 68vw, 940px);\n        height: auto;\n        box-sizing: border-box;\n        padding-bottom: 16px;\n      }\n\n      .wc-round-wrap {\n        display: flex;\n        flex-direction: column;\n        min-width: 0;\n      }\n\n      .wc-round-label {\n        position: sticky;\n        top: 0;\n        z-index: 5;\n        text-align: center;\n        color: #e2e8f0;\n        font-weight: 900;\n        font-size: 12px;\n        letter-spacing: 1.1px;\n        margin-bottom: 8px;\n        background: rgba(17,19,33,.96);\n        border: 1px solid rgba(255,255,255,.07);\n        border-radius: 999px;\n        padding: 4px 8px;\n        box-shadow: 0 6px 18px rgba(0,0,0,.16);\n      }\n\n      .wc-round-column {\n        display: flex;\n        flex: 1;\n        flex-direction: column;\n        justify-content: space-around;\n        align-items: center;\n        gap: 5px;\n        min-height: 0;\n      }\n\n      .wc-center-column {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        min-width: 0;\n      }\n\n      .wc-match-box {\n        background:\n          linear-gradient(180deg, rgba(30,32,46,.86), rgba(16,18,30,.82));\n        border: 1px solid rgba(255,255,255,.12);\n        border-radius: 11px;\n        width: 100%;\n        min-width: 0;\n        overflow: hidden;\n        box-sizing: border-box;\n        box-shadow: 0 8px 18px rgba(0,0,0,.16);\n        backdrop-filter: blur(8px);\n      }\n\n      .wc-match-live {\n        border-color: rgba(239,68,68,.70);\n        box-shadow: 0 0 14px rgba(239,68,68,.28), 0 8px 18px rgba(0,0,0,.16);\n        animation: wcLivePulse 1.6s ease-in-out infinite;\n      }\n\n      .wc-match-finished {\n        border-color: rgba(34,197,94,.34);\n        background:\n          linear-gradient(180deg, rgba(24,34,33,.86), rgba(16,24,27,.82));\n      }\n\n      .wc-match-draw {\n        border-color: rgba(245,158,11,.34);\n        background:\n          linear-gradient(180deg, rgba(42,35,20,.86), rgba(28,24,18,.82));\n      }\n\n      .wc-match-scheduled {\n        border-color: rgba(255,255,255,.11);\n      }\n\n      .wc-team-row {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 5px 8px;\n        min-width: 0;\n        box-sizing: border-box;\n        border: 1px solid transparent;\n        transition:\n          background .2s ease,\n          border-color .2s ease,\n          color .2s ease,\n          opacity .2s ease,\n          filter .2s ease;\n      }\n\n      .wc-team-row-list {\n        padding: 8px 10px;\n      }\n\n      .wc-team-row-win {\n        background: rgba(34,197,94,.14);\n        border-color: rgba(34,197,94,.22);\n        box-shadow: inset 0 0 12px rgba(34,197,94,.07);\n      }\n\n      .wc-team-row-win .wc-team-label,\n      .wc-team-row-win .wc-team-score {\n        color: #bbf7d0;\n        font-weight: 950;\n      }\n\n      .wc-team-row-lose {\n        background: rgba(127,29,29,.16);\n        border-color: rgba(239,68,68,.15);\n        opacity: .68;\n        filter: saturate(.78) brightness(.88);\n      }\n\n      .wc-team-row-lose .wc-team-label,\n      .wc-team-row-lose .wc-team-score {\n        color: #fecaca;\n      }\n\n      .wc-team-row-draw {\n        background: rgba(245,158,11,.11);\n        border-color: rgba(245,158,11,.20);\n      }\n\n      .wc-team-row-draw .wc-team-label,\n      .wc-team-row-draw .wc-team-score {\n        color: #fde68a;\n        font-weight: 900;\n      }\n\n      .wc-team-label {\n        display: flex;\n        align-items: center;\n        color: #f8fafc;\n        font-size: 12px;\n        font-weight: 750;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        min-width: 0;\n      }\n\n      .wc-team-row-list .wc-team-label {\n        font-size: 14px;\n      }\n\n      .wc-projected-label {\n        opacity: .78;\n        font-style: italic;\n      }\n\n      .wc-tbd-label {\n        color: #9aa7bd;\n        font-weight: 700;\n      }\n\n      .wc-team-score {\n        color: #e2e8f0;\n        font-size: 12px;\n        font-weight: 900;\n        margin-left: 8px;\n        flex: 0 0 auto;\n      }\n\n      .wc-team-pen-score {\n        color: #cbd5e1;\n        font-size: 9px;\n        font-weight: 850;\n        margin-left: 3px;\n        opacity: .92;\n      }\n      \n      .wc-team-row-list .wc-team-pen-score {\n        font-size: 11px;\n      }\n\n      .wc-team-row-list .wc-team-score {\n        font-size: 14px;\n      }\n\n      .wc-team-divider {\n        height: 1px;\n        background: rgba(255,255,255,.07);\n      }\n\n      .wc-flag {\n        height: 18px;\n        width: auto;\n        border-radius: 3px;\n        margin-right: 6px;\n        vertical-align: middle;\n        flex: 0 0 auto;\n      }\n\n      .wc-list-box .wc-flag {\n        height: 20px;\n      }\n\n      .wc-meta-block {\n        display: flex;\n        flex-direction: column;\n        gap: 2px;\n        color: #9aa7bd;\n        font-size: 10px;\n        padding: 4px 6px;\n        border-top: 1px solid rgba(255,255,255,.07);\n        box-sizing: border-box;\n      }\n\n      .wc-meta-block-list {\n        font-size: 11px;\n        padding: 6px 7px;\n        gap: 3px;\n      }\n\n      .wc-meta-row {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 5px;\n        min-width: 0;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-location-row {\n        opacity: .85;\n      }\n\n      .wc-meta-svg {\n        width: 12px;\n        height: 12px;\n        fill: currentColor;\n        flex: 0 0 auto;\n        opacity: .78;\n      }\n\n      .wc-meta-text {\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-status-pill {\n        border-radius: 999px;\n        padding: 2px 6px;\n        font-size: 9px;\n        font-weight: 900;\n        letter-spacing: .25px;\n        flex: 0 0 auto;\n      }\n\n      .wc-status-live {\n        color: #fecaca;\n        background: rgba(239,68,68,.16);\n        border: 1px solid rgba(239,68,68,.30);\n      }\n\n      .wc-status-finished {\n        color: #bbf7d0;\n        background: rgba(34,197,94,.12);\n        border: 1px solid rgba(34,197,94,.22);\n      }\n\n      .wc-status-draw {\n        color: #fde68a;\n        background: rgba(245,158,11,.12);\n        border: 1px solid rgba(245,158,11,.24);\n      }\n\n      .wc-status-pens {\n        color: #bbf7d0;\n        background: rgba(34,197,94,.12);\n        border: 1px solid rgba(34,197,94,.22);\n      }\n      \n      .wc-status-aet {\n        color: #bfdbfe;\n        background: rgba(59,130,246,.12);\n        border: 1px solid rgba(59,130,246,.24);\n      } \n\n      .wc-list-outer {\n        background: rgba(24,26,36,.52);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 16px;\n        padding: 8px;\n        backdrop-filter: blur(10px);\n        box-sizing: border-box;\n        width: 100%;\n        min-width: 0;\n        box-shadow: 0 8px 22px rgba(0,0,0,.14);\n      }\n\n      .wc-list-box {\n        border-radius: 11px;\n        box-shadow: none;\n      }\n\n      .wc-champion-card {\n        margin-top: 18px;\n        width: 100%;\n        max-width: 180px;\n        border-radius: 16px;\n        padding: 12px 10px;\n        box-sizing: border-box;\n        text-align: center;\n        background:\n          radial-gradient(circle at top, rgba(250,204,21,.16), transparent 52%),\n          rgba(24,26,36,.68);\n        border: 1px solid rgba(250,204,21,.22);\n        box-shadow: 0 10px 26px rgba(0,0,0,.20);\n        backdrop-filter: blur(10px);\n      }\n\n      .wc-champion-label {\n        color: #fde68a;\n        font-size: 10px;\n        font-weight: 950;\n        letter-spacing: 1.2px;\n        margin-bottom: 7px;\n      }\n\n      .wc-champion-body {\n        color: #fff;\n        font-weight: 900;\n        min-width: 0;\n      }\n\n      .wc-champion-trophy {\n        font-size: 36px;\n        line-height: 1;\n      }\n\n      .wc-champion-flag {\n        height: 42px;\n        max-width: 60px;\n        border-radius: 4px;\n        object-fit: contain;\n      }\n\n      .wc-champion-name {\n        margin-top: 6px;\n        color: #f8fafc;\n        font-size: 13px;\n        font-weight: 950;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n\n      .wc-mobile-list {\n        display: none;\n        width: 100%;\n        max-width: 100%;\n        overflow-x: hidden;\n        box-sizing: border-box;\n      }\n\n      .wc-mobile-round {\n        margin-bottom: 20px;\n        width: 100%;\n        box-sizing: border-box;\n      }\n\n      .wc-mobile-round-title {\n        color: #e2e8f0;\n        font-weight: 950;\n        font-size: 15px;\n        margin-bottom: 10px;\n        letter-spacing: .2px;\n      }\n\n      .wc-mobile-round-grid {\n        display: grid;\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: 12px;\n        width: 100%;\n        max-width: 100%;\n        box-sizing: border-box;\n        align-items: stretch;\n      }\n\n      .wc-mobile-empty {\n        color: #94a3b8;\n        font-size: 12px;\n        background: rgba(24,26,36,.48);\n        border: 1px solid rgba(255,255,255,.08);\n        border-radius: 14px;\n        padding: 10px;\n        box-sizing: border-box;\n        grid-column: 1 / -1;\n      }\n\n      .wc-fav-star {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        margin-left: 5px;\n        color: #fde047;\n        font-size: 11px;\n        font-style: normal;\n        font-weight: 950;\n        line-height: 1;\n        text-shadow: 0 0 8px rgba(250,204,21,.45);\n        flex: 0 0 auto;\n      }\n      \n      .wc-fav-star-bracket {\n        font-size: 10px;\n      }\n      \n      .wc-team-row-list .wc-fav-star-bracket {\n        font-size: 12px;\n      }\n\n      @media (max-width: ${listSwitchWidth}px) {\n        .wc-desktop-bracket {\n          display: none !important;\n        }\n\n        .wc-mobile-list {\n          display: block !important;\n        }\n\n        .wc-bracket-scroll {\n          position: static;\n          left: auto;\n          transform: none;\n          width: 100%;\n          max-width: 100%;\n          overflow-x: hidden;\n          overflow-y: visible;\n          padding: 0;\n          box-sizing: border-box;\n        }\n      }\n\n      @media (max-width: 720px) {\n        .wc-mobile-round-grid {\n          grid-template-columns: repeat(2, minmax(0, 1fr));\n          gap: 10px;\n        }\n      }\n\n      @media (max-width: 440px) {\n        .wc-mobile-round-grid {\n          grid-template-columns: 1fr;\n          gap: 8px;\n        }\n\n        .wc-mobile-round-title {\n          font-size: 14px;\n        }\n      }\n    </style>\n\n    <div class=\"wc-bracket-scroll\">\n      <div class=\"wc-desktop-bracket\">\n        ${left}${center}${right}\n      </div>\n\n      <div class=\"wc-mobile-list\">\n        ${mobileList}\n      </div>\n    </div>\n  `;\n]]]"
                  },
                  "styles": {
                    "card": [
                      {
                        "padding": 0
                      },
                      {
                        "background": "transparent"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "border": "none"
                      },
                      {
                        "width": "100%"
                      },
                      {
                        "max-width": "100%"
                      },
                      {
                        "box-sizing": "border-box"
                      }
                    ],
                    "grid": [
                      {
                        "justify-items": "stretch"
                      },
                      {
                        "grid-template-areas": "\"content\""
                      },
                      {
